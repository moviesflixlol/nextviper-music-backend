import std.time
import std.crypto
import std.string

fn record_event(profiles, events, user_id, body):
    let track_id = body["trackId"]
    let event_type = body["eventType"]
    let mut duration = 180
    if contains(keys(body), "duration"):
        duration = body["duration"]

    let mut played_seconds = 0
    if contains(keys(body), "playedSeconds"):
        played_seconds = body["playedSeconds"]

    let mut artist = ""
    if contains(keys(body), "artist"):
        artist = body["artist"]

    let mut genre = "Pop"
    if contains(keys(body), "genre"):
        genre = body["genre"]

    // Only qualified listening counts toward taste and most-listened rankings.
    if event_type == "listen" and played_seconds < 30:
        return nil
    if event_type == "listen" and contains(keys(body), "playbackId"):
        for previous in events:
            if previous["userId"] == user_id and contains(keys(previous), "playbackId") and previous["playbackId"] == body["playbackId"]:
                return nil
    let event_record = {
        "id": "evt_" + str(time.now()) + "_" + crypto.random_bytes(3),
        "userId": user_id,
        "trackId": track_id,
        "eventType": event_type,
        "duration": duration,
        "playedSeconds": played_seconds,
        "artist": artist,
        "genre": genre,
        "timestamp": time.now()
    }
    if contains(keys(body), "playbackId"):
        event_record["playbackId"] = body["playbackId"]
    append(events, event_record)

    if len(user_id) > 0 and user_id != "anonymous":
        if !contains(keys(profiles), user_id):
            profiles[user_id] = {
                "userId": user_id,
                "preferredArtists": {},
                "preferredGenres": {},
                "likedTracks": [],
                "dislikedTracks": [],
                "history": [],
                "skippedTracks": []
            }

        let user_prof = profiles[user_id]
        if !contains(keys(user_prof), "listens"):
            user_prof["listens"] = {}
        if event_type == "listen" and contains(keys(body), "title") and contains(keys(body), "thumbnail"):
            let mut count = 0
            if contains(keys(user_prof["listens"]), track_id):
                count = user_prof["listens"][track_id]["playCount"]
            user_prof["listens"][track_id] = {"id": track_id, "title": body["title"], "artist": artist, "thumbnail": body["thumbnail"], "duration": "", "genre": genre, "playCount": count + 1, "lastPlayed": time.now()}


        if event_type == "listen":
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.35

            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.35

            let mut recent = []
            for previous in user_prof["history"]:
                if previous != track_id:
                    append(recent, previous)
            append(recent, track_id)
            user_prof["history"] = recent

        elif event_type == "like":
            if !contains(user_prof["likedTracks"], track_id):
                append(user_prof["likedTracks"], track_id)
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.40
            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.40

        elif event_type == "dislike":
            if !contains(user_prof["dislikedTracks"], track_id):
                append(user_prof["dislikedTracks"], track_id)
            if len(artist) > 0 and contains(keys(user_prof["preferredArtists"]), artist):
                user_prof["preferredArtists"][artist] = user_prof["preferredArtists"][artist] - 0.40

        elif event_type == "add_to_playlist":
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.35
            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.35

        elif event_type == "skip":
            if played_seconds < 15:
                if !contains(user_prof["skippedTracks"], track_id):
                    append(user_prof["skippedTracks"], track_id)
                if len(artist) > 0 and contains(keys(user_prof["preferredArtists"]), artist):
                    user_prof["preferredArtists"][artist] = user_prof["preferredArtists"][artist] - 0.15


fn most_listened(profile):
    let mut ranked = []
    if profile == nil or !contains(keys(profile), "listens"):
        return ranked
    let listens = profile["listens"]
    let mut used = []
    for i in range(0, 12):
        let mut best = nil
        for id in keys(listens):
            let item = listens[id]
            if !contains(used, id):
                if best == nil:
                    best = item
                elif item["playCount"] > best["playCount"]:
                    best = item
                elif item["playCount"] == best["playCount"] and item["lastPlayed"] > best["lastPlayed"]:
                    best = item
        if best == nil:
            break
        append(used, best["id"])
        append(ranked, best)
    return ranked

fn choose_tracks(pools, excluded, disliked, skipped, history, limit):
    let mut result = []
    let mut seen = excluded
    let mut signatures = []
    let mut artist_counts = {}
    // First suggest discoveries; familiar tracks may fill remaining places.
    for familiar in range(0, 2):
        for depth in range(0, 50):
            for pool in pools:
                if depth < len(pool):
                    let item = pool[depth]
                    let id = item["id"]
                    let artist = item["artist"]
                    let signature = string.to_lower(item["title"]) + "_" + string.to_lower(artist)
                    let mut count = 0
                    if contains(keys(artist_counts), artist):
                        count = artist_counts[artist]
                    if !contains(seen, id) and !contains(signatures, signature) and !contains(disliked, id) and !contains(skipped, id) and count < 3:
                        if familiar == 1 or !contains(history, id):
                            append(seen, id)
                            append(signatures, signature)
                            append(result, item)
                            artist_counts[artist] = count + 1
                            if len(result) >= limit:
                                return result
    return result
