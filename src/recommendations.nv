fn record_event(profiles, events, user_id, body):
    let track_id = body["trackId"]
    let event_type = body["eventType"]
    let mut duration = 180
    if contains(keys(body), "duration"):
        duration = body["duration"]

    let mut played_seconds = 0
    if contains(keys(body), "playedSeconds"):
        played_seconds = body["playedSeconds"]

    let mut artist = ""
    if contains(keys(body), "artist"):
        artist = body["artist"]

    let mut genre = "Pop"
    if contains(keys(body), "genre"):
        genre = body["genre"]

    let event_record = {
        "id": "evt_" + str(time.now()) + "_" + crypto.random_bytes(3),
        "userId": user_id,
        "trackId": track_id,
        "eventType": event_type,
        "duration": duration,
        "playedSeconds": played_seconds,
        "artist": artist,
        "genre": genre,
        "timestamp": time.now()
    }
    append(events, event_record)

    if len(user_id) > 0 and user_id != "anonymous":
        if !contains(keys(profiles), user_id):
            profiles[user_id] = {
                "userId": user_id,
                "preferredArtists": {},
                "preferredGenres": {},
                "likedTracks": [],
                "dislikedTracks": [],
                "history": [],
                "skippedTracks": []
            }

        let user_prof = profiles[user_id]

        if event_type == "play" or event_type == "complete":
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.35

            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.35

            if !contains(user_prof["history"], track_id):
                append(user_prof["history"], track_id)

        elif event_type == "like":
            if !contains(user_prof["likedTracks"], track_id):
                append(user_prof["likedTracks"], track_id)
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.40
            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.40

        elif event_type == "dislike":
            if !contains(user_prof["dislikedTracks"], track_id):
                append(user_prof["dislikedTracks"], track_id)
            if len(artist) > 0 and contains(keys(user_prof["preferredArtists"]), artist):
                user_prof["preferredArtists"][artist] = user_prof["preferredArtists"][artist] - 0.40

        elif event_type == "add_to_playlist":
            if len(artist) > 0:
                let mut cur = 0.5
                if contains(keys(user_prof["preferredArtists"]), artist):
                    cur = user_prof["preferredArtists"][artist]
                user_prof["preferredArtists"][artist] = cur + 0.35
            if len(genre) > 0:
                let mut cur_g = 0.5
                if contains(keys(user_prof["preferredGenres"]), genre):
                    cur_g = user_prof["preferredGenres"][genre]
                user_prof["preferredGenres"][genre] = cur_g + 0.35

        elif event_type == "skip":
            if played_seconds < 15:
                if !contains(user_prof["skippedTracks"], track_id):
                    append(user_prof["skippedTracks"], track_id)
                if len(artist) > 0 and contains(keys(user_prof["preferredArtists"]), artist):
                    user_prof["preferredArtists"][artist] = user_prof["preferredArtists"][artist] - 0.15

// Pick N random items from a list using current time + seed as entropy
fn pick_random_n(pool, n, seed):
    let pool_len = len(pool)
    if pool_len == 0:
        return []
    if n >= pool_len:
        return pool

    // Shuffle-like selection using seed
    let mut picked = []
    let mut used = []
    let mut i = 0
    let mut attempts = 0
    while len(picked) < n and attempts < pool_len * 3:
        let idx = (seed + i * 7 + attempts * 3) % pool_len
        if !contains(used, idx):
            append(used, idx)
            append(picked, pool[idx])
        i = i + 1
        attempts = attempts + 1
    return picked

fn generate_keywords_for_user(category, country, user_prof, seed):
    let mut keywords = []

    if category == "Podcasts":
        // Pick 5 random podcasts from pool
        keywords = pick_random_n(PODCAST_KEYWORD_POOL, 5, seed)
        return keywords

    if user_prof != nil:
        // 1. Top scored genres → pick random keywords from their pools
        let pref_genres = user_prof["preferredGenres"]
        let mut genre_list = []
        for g in keys(pref_genres):
            if pref_genres[g] > 0.4:
                append(genre_list, g)

        for g in genre_list:
            if contains(keys(GENRE_KEYWORD_POOL), g):
                let pool = GENRE_KEYWORD_POOL[g]
                // Pick 2 random keywords from this genre's pool
                let picked = pick_random_n(pool, 2, seed + len(g))
                for kw in picked:
                    append(keywords, kw)

        // 2. Top scored artists → direct artist search queries
        let pref_artists = user_prof["preferredArtists"]
        let mut artist_list = []
        for a in keys(pref_artists):
            if pref_artists[a] > 0.6:
                append(artist_list, a)

        // Pick 2 random artists and add them as queries
        let picked_artists = pick_random_n(artist_list, 2, seed + 13)
        for a in picked_artists:
            append(keywords, a + " latest songs 2026")

    // 3. Fill remaining slots with random country-specific keywords
    let c_pool_key = country
    let mut c_pool = COUNTRY_KEYWORD_POOL["DEFAULT"]
    if contains(keys(COUNTRY_KEYWORD_POOL), country):
        c_pool = COUNTRY_KEYWORD_POOL[country]

    // Always add 3 random country keywords so every request has fresh variety
    let country_picks = pick_random_n(c_pool, 3, seed + 31)
    for kw in country_picks:
        append(keywords, kw)

    // 4. If still too few (new user with no history), fill from multiple genre pools
    if len(keywords) < 4:
        let all_genre_keys = keys(GENRE_KEYWORD_POOL)
        let genre_picks = pick_random_n(all_genre_keys, 3, seed + 53)
        for g in genre_picks:
            let pool = GENRE_KEYWORD_POOL[g]
            let kw = pick_random_n(pool, 1, seed + len(g) + 71)
            for k in kw:
                append(keywords, k)

    return keywords
