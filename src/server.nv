// --- Auth Helper Functions ---

fn extract_token_from_header(auth_header):
    if len(auth_header) < 8:
        return ""
    // Format is "Bearer <token>"
    let prefix = auth_header.substr(0, 7)
    if prefix == "Bearer " or prefix == "bearer ":
        return auth_header.substr(7)
    return auth_header

fn authenticate_request(req):
    let headers = req["headers"]
    if !contains(keys(headers), "authorization"):
        return nil
    let auth_header = headers["authorization"]
    let token = extract_token_from_header(auth_header)
    if len(token) == 0:
        return nil
    let claims = crypto.jwt_decode(token, JWT_SECRET)
    return claims

// --- Initialize HTTP Server ---
let app = http.server()

