            "timestamp": time.now(),
            "usersCount": len(users),
            "playlistsCount": len(playlists),
            "eventsCount": len(events)
        }
    }

app.get("/health", handle_health)
app.get("/api/health", handle_health)

// --- 2. Authentication Endpoints with Resend Quota Fallback ---

// Register New User
fn handle_register(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing required fields: email and password" }
        }

    let email = body["email"]
    let password = body["password"]
    let mut name = "Viper User"
    if contains(keys(body), "name") and len(body["name"]) > 0:
        name = body["name"]

    let mut interests = []
    if contains(keys(body), "interests"):
        interests = body["interests"]

    if len(email) < 4 or len(password) < 6:
        return {
            "status": 400,
            "body": { "error": "Email must be valid and password must be at least 6 characters" }
        }

    // Check if user already exists
    for u in users:
        if u["email"] == email:
            return {
                "status": 409,
                "body": { "error": "An account with this email already exists" }
            }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)
    let password_hash = crypto.hash_password(password)

    let html = email_service.build_email_template(
        "Your music journey starts here.",
        "WELCOME TO MUSIC",
        "Welcome to MUSIC! Discover your favorite artists, explore new sounds, and enjoy playlists made just for you.",
        otp_code
    )

    let email_sent = email_service.send_resend_email(email, "Welcome to MUSIC - Verify Your Email", html)

    // Fallback: If Resend SMTP hit daily quota or failed, allow direct signup without OTP!
    if !email_sent:
        print("[Resend Quota/Failure] Email delivery failed or daily quota reached. Allowing direct user signup without OTP.")

        let user_id = "usr_" + str(time.now()) + "_" + crypto.random_bytes(4)
        let new_user = {
            "id": user_id,
            "email": email,
            "name": name,
            "passwordHash": password_hash,
            "createdAt": time.now(),
            "emailVerified": false
        }
        append(users, new_user)
        database.save_db("users.json", users)

        let mut user_genres = {}
        for g in interests:
            user_genres[g] = 1.0

        profiles[user_id] = {
            "userId": user_id,
            "preferredArtists": {},
            "preferredGenres": user_genres,
            "likedTracks": [],
            "dislikedTracks": [],
            "history": [],
            "skippedTracks": []
        }
        database.save_db("profiles.json", profiles)

        let token_payload = {
            "userId": user_id,
            "email": email,
            "name": name,
            "exp": int(time.now()) + 2592000
        }
        let token = crypto.jwt_encode(token_payload, JWT_SECRET)

        return {
            "status": 201,
            "body": {
                "success": true,
                "verificationRequired": false,
                "token": token,
                "user": {
                    "id": user_id,
                    "email": email,
                    "name": name
                },
                "message": "Account created successfully! Welcome to MUSIC."
            }
        }

    // Normal flow: OTP sent to user email
    PENDING_REGISTRATIONS[email] = {
        "email": email,
        "name": name,
        "passwordHash": password_hash,
        "interests": interests,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    print("Issued verification code for new user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "verificationRequired": true,
            "email": email,
            "message": "Verification code sent to " + email
        }
    }

app.post("/api/auth/register", handle_register)

// Verify Email with 6-digit OTP
fn handle_verify_email(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code"):
        return {
            "status": 400,
            "body": { "error": "Missing email or verification code" }
        }

    let email = body["email"]
    let code = body["code"]

    if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No pending registration found for this email. Please sign up again." }
        }

    let pending = PENDING_REGISTRATIONS[email]
    if time.now() > pending["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Verification code has expired. Please request a new code." }
        }

    if pending["otp"] != code:
        return {
            "status": 400,
            "body": { "error": "Invalid verification code. Please check your email and try again." }
        }

    let user_id = "usr_" + str(time.now()) + "_" + crypto.random_bytes(4)
    let new_user = {
        "id": user_id,
        "email": pending["email"],
        "name": pending["name"],
        "passwordHash": pending["passwordHash"],
        "createdAt": time.now(),
        "emailVerified": true
    }
    append(users, new_user)
    database.save_db("users.json", users)

    let mut user_genres = {}
    for g in pending["interests"]:
        user_genres[g] = 1.0

    profiles[user_id] = {
        "userId": user_id,
        "preferredArtists": {},
        "preferredGenres": user_genres,
        "likedTracks": [],
        "dislikedTracks": [],
        "history": [],
        "skippedTracks": []
    }
    database.save_db("profiles.json", profiles)

    PENDING_REGISTRATIONS[email] = nil

    let token_payload = {
        "userId": user_id,
        "email": email,
        "name": pending["name"],
        "exp": int(time.now()) + 2592000
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("Verified email and registered user:", email, "(" + user_id + ")")

    return {
        "status": 201,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": user_id,
                "email": email,
                "name": pending["name"]
            }
        }
    }

app.post("/api/auth/verify-email", handle_verify_email)

// Login User
fn handle_login(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing email or password" }
        }

    let email = body["email"]
    let password = body["password"]

    let mut found_user = nil
    for u in users:
        if u["email"] == email:
            found_user = u

    if found_user == nil:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    let valid = crypto.verify_password(password, found_user["passwordHash"])
    if !valid:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    let token_payload = {
        "userId": found_user["id"],
        "email": found_user["email"],
        "name": found_user["name"],
        "exp": int(time.now()) + 2592000
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("User logged in successfully:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": found_user["id"],
                "email": found_user["email"],
                "name": found_user["name"]
            }
        }
    }

app.post("/api/auth/login", handle_login)

// Request Password Reset OTP
fn handle_forgot_password(req):
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email address" }
        }

    let email = body["email"]
    let mut found = false
    for u in users:
        if u["email"] == email:
            found = true

    if !found:
        return {
            "status": 404,
            "body": { "error": "No account registered with this email address." }
        }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    let html = email_service.build_email_template(
        "Reset your password.",
        "ACCOUNT SECURITY",
        "Use the verification code below to reset your password. This code expires in 10 minutes.",
        otp_code
    )

    let email_sent = email_service.send_resend_email(email, "Password Reset Code - MUSIC", html)

    // If Resend failed (e.g. quota limit reached): return try later error!
    if !email_sent:
        return {
            "status": 429,
            "body": { "error": "Email service daily limit reached. Please try again later or contact support." }
        }

    PASSWORD_RESETS[email] = {
        "email": email,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    print("Issued password reset code for:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Password reset code sent to your email."
        }
    }

app.post("/api/auth/forgot-password", handle_forgot_password)

// Complete Password Reset
fn handle_reset_password(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code") or !contains(keys(body), "newPassword"):
        return {
            "status": 400,
            "body": { "error": "Missing email, code, or newPassword" }
        }

    let email = body["email"]
    let code = body["code"]
    let newPassword = body["newPassword"]

    if len(newPassword) < 6:
        return {
            "status": 400,
            "body": { "error": "New password must be at least 6 characters" }
        }

    if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No password reset request found for this email." }
        }

    let reset_req = PASSWORD_RESETS[email]
    if time.now() > reset_req["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Password reset code has expired. Please request a new one." }
        }

    if reset_req["otp"] != code:
        return {
            "status": 400,
            "body": { "error": "Invalid reset code. Please check your email and try again." }
        }

    let new_hash = crypto.hash_password(newPassword)
    for u in users:
        if u["email"] == email:
            u["passwordHash"] = new_hash

    database.save_db("users.json", users)
    PASSWORD_RESETS[email] = nil

    print("Successfully reset password for user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Your password has been reset successfully. You can now log in."
        }
    }

app.post("/api/auth/reset-password", handle_reset_password)

// Resend Verification / Reset Code
fn handle_resend_code(req):
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email" }
        }

    let email = body["email"]
    let mut req_type = "signup"
    if contains(keys(body), "type"):
        req_type = body["type"]

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    if req_type == "reset":
        if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending reset request for this email." }
            }
        let html = email_service.build_email_template("Reset your password.", "ACCOUNT SECURITY", "Use the verification code below to reset your password. This code expires in 10 minutes.", otp_code)
        let ok = email_service.send_resend_email(email, "Password Reset Code - MUSIC", html)
        if !ok:
            return {
                "status": 429,
                "body": { "error": "Email service daily limit reached. Please try again later." }
            }
        PASSWORD_RESETS[email]["otp"] = otp_code
        PASSWORD_RESETS[email]["expiresAt"] = time.now() + 600.0
        return {
            "status": 200,
            "body": { "success": true, "message": "A new password reset code has been sent." }
        }
    else:
        if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending registration for this email." }
            }
        let html = email_service.build_email_template("Your music journey starts here.", "WELCOME TO MUSIC", "Welcome to MUSIC! Discover your favorite artists, explore new sounds, and enjoy playlists made just for you.", otp_code)
        let ok = email_service.send_resend_email(email, "Welcome to MUSIC - Verify Your Email", html)
        if !ok:
            // Allow direct verification if email service fails
            let pending = PENDING_REGISTRATIONS[email]
            let user_id = "usr_" + str(time.now()) + "_" + crypto.random_bytes(4)
            let new_user = {
                "id": user_id,
                "email": pending["email"],
                "name": pending["name"],
                "passwordHash": pending["passwordHash"],
                "createdAt": time.now(),
                "emailVerified": false
            }
            append(users, new_user)
            database.save_db("users.json", users)
            PENDING_REGISTRATIONS[email] = nil
            let token_payload = {
                "userId": user_id,
                "email": email,
                "name": pending["name"],
                "exp": int(time.now()) + 2592000
            }
            let token = crypto.jwt_encode(token_payload, JWT_SECRET)
            return {
                "status": 200,
                "body": { "success": true, "verificationRequired": false, "token": token, "message": "Account activated directly." }
            }

        PENDING_REGISTRATIONS[email]["otp"] = otp_code
        PENDING_REGISTRATIONS[email]["expiresAt"] = time.now() + 600.0
        return {
            "status": 200,
            "body": { "success": true, "message": "A new verification code has been sent." }
        }

app.post("/api/auth/resend-code", handle_resend_code)

// Current User Profile
fn handle_me(req):
    let claims = authenticate_request(req)
    if claims == nil:
        return {
            "status": 401,
            "body": { "error": "Unauthorized. Invalid or missing token." }
        }

    let user_id = claims["userId"]
    let mut current_user = nil
    for u in users:
        if u["id"] == user_id:
            current_user = u

    if current_user == nil:
        return {
            "status": 404,
            "body": { "error": "User not found" }
        }

    let mut email_verified = false
    if contains(keys(current_user), "emailVerified"):
        email_verified = current_user["emailVerified"] == true

    return {
        "status": 200,
        "body": {
            "user": {
                "id": current_user["id"],
                "email": current_user["email"],
                "name": current_user["name"],
                "createdAt": current_user["createdAt"],
                "emailVerified": email_verified
            }
        }
    }

app.get("/api/auth/me", handle_me)

// --- 3. Cloud Playlists Endpoints (Preserve Existing Ownership) ---

// List Playlists
fn handle_list_playlists(req):
    let claims = authenticate_request(req)
    let headers = req["headers"]
    if contains(keys(headers), "authorization") and claims == nil:
        return { "status": 401, "body": { "error": "Sign in again." } }
    let user_id = playlist_owner(req)
    let mut user_playlists = []
    for pl in playlists:
        let pl_uid = pl["userId"]
        if pl_uid == "public" or (len(user_id) > 0 and pl_uid == user_id) or (claims == nil and pl_uid == "guest_user"):
            append(user_playlists, pl)

    return {
        "status": 200,
        "body": {
            "count": len(user_playlists),
            "playlists": user_playlists
        }
    }

app.get("/api/playlists", handle_list_playlists)

// Create New Playlist (Accepts ID from client to prevent disassociation)
fn handle_create_playlist(req):
    let user_id = playlist_owner(req)
    if len(user_id) == 0:
        return { "status": 401, "body": { "error": "A user session or private device library is required." } }

    let body = req.json()
    if !contains(keys(body), "name") or len(body["name"]) == 0:
        return {
            "status": 400,
            "body": { "error": "Playlist name cannot be empty" }
        }

    let mut desc = "Curated by user"
    if contains(keys(body), "description"):
        desc = body["description"]

    let mut cover = "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=80"
    if contains(keys(body), "coverUrl") and len(body["coverUrl"]) > 0:
        cover = body["coverUrl"]

    let mut pl_id = "pl_" + str(time.now()) + "_" + crypto.random_bytes(4)
    if contains(keys(body), "id") and len(body["id"]) > 0:
        pl_id = body["id"]

    // Check if playlist with this ID already exists
    let mut existing_pl = nil
    for pl in playlists:
        if pl["id"] == pl_id:
            existing_pl = pl

    if existing_pl != nil:
        if !can_edit_playlist(req, existing_pl):
            return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }
        return {
            "status": 200,
            "body": existing_pl
        }

    let new_pl = {
        "id": pl_id,
        "userId": user_id,
        "name": body["name"],
        "description": desc,
        "coverUrl": cover,
        "tracks": [],
        "isAutoGenerated": false,
        "createdAt": time.now(),
        "updatedAt": time.now()
    }

    append(playlists, new_pl)
    database.save_db("playlists.json", playlists)

    print("Created cloud playlist:", body["name"], "(" + pl_id + ")")

    return {
        "status": 201,
        "body": new_pl
    }

app.post("/api/playlists", handle_create_playlist)

// Add Track to Playlist
fn handle_add_track_to_playlist(req):
    let pl_id = req["params"]["id"]
    let body = req.json()

    if !contains(keys(body), "track"):
        return {
            "status": 400,
            "body": { "error": "Missing 'track' object in request body" }
        }

    let track = body["track"]
    let mut found_pl = nil
    for pl in playlists:
        if pl["id"] == pl_id:
            found_pl = pl

    if found_pl == nil:
        return {
            "status": 404,
            "body": { "error": "Playlist not found", "id": pl_id }
        }

    if !can_edit_playlist(req, found_pl):
        return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }

    // Avoid duplicates
    let mut already_in = false
    for t in found_pl["tracks"]:
        if t["id"] == track["id"]:
            already_in = true

    if !already_in:
        append(found_pl["tracks"], track)
        found_pl["updatedAt"] = time.now()
        database.save_db("playlists.json", playlists)

    print("Added track to playlist:", track["title"], "->", found_pl["name"])

    return {
        "status": 200,
        "body": found_pl
    }

app.post("/api/playlists/:id/tracks", handle_add_track_to_playlist)

// Delete Playlist
fn handle_delete_playlist(req):
    let pl_id = req["params"]["id"]
    let mut new_playlists = []
    let mut deleted = false

    for pl in playlists:
        if pl["id"] == pl_id:
            if !can_edit_playlist(req, pl):
                return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }
            deleted = true
        else:
            append(new_playlists, pl)

    if !deleted:
        return {
            "status": 404,
            "body": { "error": "Playlist not found", "id": pl_id }
        }

    playlists = new_playlists
    database.save_db("playlists.json", playlists)

    print("Deleted playlist:", pl_id)

    return {
        "status": 200,
        "body": { "success": true, "deleted": pl_id }
    }

app.delete("/api/playlists/:id", handle_delete_playlist)

// --- 4. Recommendation Telemetry & Category-Aware Feed ---

// Telemetry Event
fn handle_recommendation_event(req):
    let claims = authenticate_request(req)
    let headers = req["headers"]
    let mut user_id = "anonymous"
    if claims != nil and contains(keys(claims), "userId"):
        user_id = claims["userId"]
    elif contains(keys(headers), "x-session-id") and len(headers["x-session-id"]) > 0:
        user_id = headers["x-session-id"]
    elif contains(keys(headers), "x-device-id") and len(headers["x-device-id"]) > 0:
        user_id = headers["x-device-id"]

    let body = req.json()
    if !contains(keys(body), "trackId") or !contains(keys(body), "eventType"):
        return {
            "status": 400,
            "body": { "error": "Missing 'trackId' or 'eventType'" }
        }

    recommendations.record_event(profiles, events, user_id, body)
    database.save_db("events.json", events)
    database.save_db("profiles.json", profiles)

    print("Telemetry recorded:", body["eventType"], "for", body["trackId"], "(user: " + user_id + ")")

    return {
        "status": 200,
        "body": { "success": true, "message": "Signal recorded" }
    }

app.post("/api/recommendations/event", handle_recommendation_event)

// Recommendations Feed (Category-Aware: All / Music / Podcasts)
fn handle_feed(req):
    let claims = authenticate_request(req)
    let headers = req["headers"]
    let mut user_id = ""
    if claims != nil and contains(keys(claims), "userId"):
        user_id = claims["userId"]
    elif contains(keys(headers), "x-session-id") and len(headers["x-session-id"]) > 0:
        user_id = headers["x-session-id"]
    elif contains(keys(headers), "x-device-id") and len(headers["x-device-id"]) > 0:
        user_id = headers["x-device-id"]

    let mut user_prof = nil
    if len(user_id) > 0 and contains(keys(profiles), user_id):
        user_prof = profiles[user_id]

    let query_map = req["query"]
    let mut category = "All"
    if contains(keys(query_map), "category"):
        category = query_map["category"]

    let mut country = "IN"
    if contains(keys(query_map), "country") and len(query_map["country"]) > 0:
        country = query_map["country"]
    elif contains(keys(headers), "cf-ipcountry") and len(headers["cf-ipcountry"]) > 0:
        country = headers["cf-ipcountry"]
    elif contains(keys(headers), "x-country-code") and len(headers["x-country-code"]) > 0:
        country = headers["x-country-code"]

    let keywords = recommendations.generate_keywords_for_user(category, country, user_prof, int(time.now() * 1000) % 9999)

    // Execute queries with user-scoped cache — each user gets their own fresh pool
    let mut track_pools = []
    let max_keywords = 6
    let num_kw = len(keywords)

    let mut kw_count = 0
    for i in range(0, num_kw) {
        if kw_count < max_keywords:
            let kw = keywords[i]
            let pool = innertube.search_youtube_cached_for_user(kw, country, user_id)
            if len(pool) > 0:
                append(track_pools, pool)
            kw_count = kw_count + 1
    }

    // Interleave tracks into main pool (deduplicated, anti-artist saturation max 2 per artist)
    let mut blended_tracks = []
    let mut seen_ids = []
    let mut artist_counts = {}

    let mut disliked = []
    if user_prof != nil:
        disliked = user_prof["dislikedTracks"]

    let max_depth = 15
    for depth in range(0, max_depth) {
        for pool in track_pools {
            if depth < len(pool):
                let t = pool[depth]
                let t_id = t["id"]
                let t_artist = t["artist"]

                if !contains(seen_ids, t_id) and !contains(disliked, t_id):
                    let mut a_cnt = 0
                    if contains(keys(artist_counts), t_artist):
                        a_cnt = artist_counts[t_artist]

                    if a_cnt < 2:
                        append(seen_ids, t_id)
                        artist_counts[t_artist] = a_cnt + 1
                        append(blended_tracks, t)
        }
    }

    if len(blended_tracks) == 0:
        blended_tracks = recommendations.CATALOG_TRACKS

    let featured = blended_tracks[0]

    // Split into recommended (first half) and trending (second half)
    // so both sections show DIFFERENT songs, not alternating from the same pool
    let total = len(blended_tracks)
    let half = total / 2
    let mut recommended_tracks = []
    let mut trending_tracks = []

    for i in range(0, total) {
        if i < half:
            append(recommended_tracks, blended_tracks[i])
        else:
            append(trending_tracks, blended_tracks[i])
    }

    // If not enough tracks for both sections, fetch a separate trending pool
    if len(trending_tracks) < 5:
        let mut trending_kw = "global trending music 2026"
        if country == "IN":
            trending_kw = "india viral songs this week"
        elif country == "US":
            trending_kw = "us chart toppers 2026"
        let trend_pool = innertube.search_youtube_cached_for_user(trending_kw, country, user_id + "_t")
        let mut t_seen = []
        for bt in blended_tracks {
            append(t_seen, bt["id"])
        }
        for tr in trend_pool {
            if !contains(t_seen, tr["id"]) and len(trending_tracks) < 20:
                append(trending_tracks, tr)
        }

    // Extract unique artists
    let mut feed_artists = []
    let mut seen_artists = []
    for tr in blended_tracks {
        let a_name = tr["artist"]
        let a_thumb = tr["thumbnail"]
        if len(a_name) > 0 and !contains(seen_artists, a_name) and a_name != "Various Artists" and a_name != "Song" and a_name != "Video":
            append(seen_artists, a_name)
            append(feed_artists, {
                "name": a_name,
                "imageUrl": a_thumb,
                "genre": tr["genre"]
            })
            if len(feed_artists) >= 12:
                break
    }

    // Partition into personalized mixes
    let mut daily_mix_tracks = []
    let mut chill_mix_tracks = []
    let mut workout_mix_tracks = []
    let mut gems_mix_tracks = []

    for i in range(0, len(blended_tracks)) {
        let item = blended_tracks[i]
        if i % 4 == 0:
            append(daily_mix_tracks, item)
        elif i % 4 == 1:
            append(chill_mix_tracks, item)
        elif i % 4 == 2:
            append(workout_mix_tracks, item)
        else:
            append(gems_mix_tracks, item)
    }

    // Build personalized mix titles based on top preferred genre/artist
    let mut daily_mix_title = "Daily Mix 1"
    let mut chill_mix_title = "Chill Rotation"
    let mut workout_mix_title = "Workout Energy"
    let mut gems_mix_title = "Hidden Gems"

    if user_prof != nil:
        let pref_genres = user_prof["preferredGenres"]
        let mut top_genre = ""
        let mut top_genre_score = 0.0
        for g in keys(pref_genres):
            if pref_genres[g] > top_genre_score:
                top_genre_score = pref_genres[g]
                top_genre = g

        if len(top_genre) > 0:
            daily_mix_title = top_genre + " Mix"
            gems_mix_title = "More " + top_genre

        let pref_artists = user_prof["preferredArtists"]
        let mut top_artist = ""
        let mut top_artist_score = 0.0
        for a in keys(pref_artists):
            if pref_artists[a] > top_artist_score:
                top_artist_score = pref_artists[a]
                top_artist = a

        if len(top_artist) > 0:
            chill_mix_title = top_artist + " Radio"

    // Use user_id in mix IDs so Flutter can cache per-user and avoid stale same-content tiles
    let mut mix_id_prefix = "anon"
    if len(user_id) > 0:
        mix_id_prefix = user_id

    let mixes = [
        {
            "id": "mix_daily_" + mix_id_prefix,
            "title": daily_mix_title,
            "description": "Personalized blend matching your latest musical affinity.",
            "coverUrl": "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=80",
            "tracks": daily_mix_tracks,
            "isAutoGenerated": true
        },
        {
            "id": "mix_chill_" + mix_id_prefix,
            "title": chill_mix_title,
            "description": "Acoustic vibes, lo-fi beats, and relaxing melodies.",
            "coverUrl": "https://images.unsplash.com/photo-1445985543470-41fdd6ce388d?w=600&q=80",
            "tracks": chill_mix_tracks,
            "isAutoGenerated": true
        },
        {
            "id": "mix_workout_" + mix_id_prefix,
            "title": workout_mix_title,
            "description": "High-octane power tracks to push your limits.",
            "coverUrl": "https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=600&q=80",
            "tracks": workout_mix_tracks,
            "isAutoGenerated": true
        },
        {
            "id": "mix_gems_" + mix_id_prefix,
            "title": gems_mix_title,
            "description": "Undiscovered sounds tailored to your unique tastes.",
            "coverUrl": "https://images.unsplash.com/photo-1514525253161-7a46d19cd819?w=600&q=80",
            "tracks": gems_mix_tracks,
            "isAutoGenerated": true
        }
    ]

    // Build list of user's active interest genres for Flutter to use in "load more"
    let mut user_interests = []
    if user_prof != nil:
        let pref_genres = user_prof["preferredGenres"]
        for g in keys(pref_genres):
            if pref_genres[g] > 0.4:
                append(user_interests, g)

    return {
        "status": 200,
        "body": {
            "category": category,
            "country": country,
            "userId": user_id,
            "userInterests": user_interests,
            "featured": featured,
            "recommendedForYou": recommended_tracks,
            "trending": trending_tracks,
            "artists": feed_artists,
            "mixes": mixes,
            "algorithmVersion": "NextViper-RS-Dynamic-3.2"
        }
    }

app.get("/api/recommendations/feed", handle_feed)

// --- 5. InnerTube Search & Stream Resolver Endpoints ---

// Search Endpoint
fn handle_search(req):
    let query_map = req["query"]
    let mut q = ""
    if contains(keys(query_map), "q"):
        q = query_map["q"]
    let mut country = "IN"
    if contains(keys(query_map), "country"):
        country = query_map["country"]

    if len(q) == 0:
        return {
            "status": 400,
            "body": { "error": "Missing 'q' query parameter" }
        }

    print("Searching YouTube Music for:", q, "(country: " + country + ")")
    let results = innertube.search_youtube_cached(q, country)

    return {
        "status": 200,
        "body": {
            "query": q,
            "country": country,
            "count": len(results),
            "results": results
        }
    }

app.get("/api/search", handle_search)

// Track Stream Resolution Endpoint
fn handle_resolve(req):
    let query_map = req["query"]
    let mut video_id = ""
    if contains(keys(query_map), "id"):
        video_id = query_map["id"]

    if len(video_id) == 0:
        return {
            "status": 400,
            "body": { "error": "Missing 'id' query parameter" }
        }

    let stream_res = innertube.resolve_innertube_stream(video_id)
    return stream_res

app.get("/api/resolve", handle_resolve)

// --- 6. Start Server ---

let mut port = 8080
let host = env.get("HOST", "0.0.0.0")

let env_port = env.get("PORT")
if env_port != nil and len(str(env_port)) > 0:
    port = int(env_port)

print("NextViper Production Music Backend listening on http://" + host + ":" + str(port))
app.listen(port, host, false)
