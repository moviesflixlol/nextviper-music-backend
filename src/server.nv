print("==================================================")
print("  Initializing NextViper Modular Music Backend    ")
print("  Runtime: NextViper 1.0.0 (Apex)                 ")
print("==================================================")

let JWT_SECRET = env.get("VIPER_JWT_SECRET", "")
if len(JWT_SECRET) < 64:
    print("VIPER_JWT_SECRET must be configured with at least 64 characters")
    process.exit(1)

// Initialize In-Memory / Persistent Storage
let mut users = database.load_db("users.json", [])
let mut playlists = database.load_db("playlists.json", [])
let mut events = database.load_db("events.json", [])
let mut profiles = database.load_db("profiles.json", {})

let mut PENDING_REGISTRATIONS = {}
let mut PASSWORD_RESETS = {}

print("Loaded Database:")
print(" - Users count: " + str(len(users)))
print(" - Playlists count: " + str(len(playlists)))
print(" - Events count: " + str(len(events)))

let app = http.server()

// --- CORS & Authentication Middleware ---

fn authenticate_request(req):
    let headers = req["headers"]
    if !contains(keys(headers), "authorization"):
        return nil

    let auth_header = headers["authorization"]
    if len(auth_header) < 8 or auth_header[0:7] != "Bearer ":
        return nil

    let mut token = ""
    if len(auth_header) > 7:
        token = auth_header[7:]

    let claims = crypto.jwt_decode(token, JWT_SECRET)
    if typeof(claims) != "Object":
        return nil
    if !contains(keys(claims), "userId") or !contains(keys(claims), "exp"):
        return nil
    if typeof(claims["userId"]) != "String" or len(claims["userId"]) == 0:
        return nil
    if typeof(claims["exp"]) != "Int" and typeof(claims["exp"]) != "Float":
        return nil
    if claims["exp"] <= time.now():
        return nil
    let mut exists = false
    for user in users:
        if user["id"] == claims["userId"]:
            exists = true
    if !exists:
        return nil
    return claims

// Device IDs identify existing guest libraries; they never transfer ownership.
fn playlist_owner(req):
    let claims = authenticate_request(req)
    if claims != nil:
        return claims["userId"]
    let headers = req["headers"]
    if contains(keys(headers), "authorization"):
        return ""
    let mut device_id = ""
    if contains(keys(headers), "x-device-id"):
        device_id = headers["x-device-id"]
    elif contains(keys(headers), "x-session-id"):
        device_id = headers["x-session-id"]
    if len(device_id) > 8 and device_id[0:4] == "dev_" and device_id != "dev_guest":
        return device_id
    return ""

fn can_edit_playlist(req, playlist):
    let owner = playlist_owner(req)
    return len(owner) > 0 and playlist["userId"] == owner

