// --- 2. Authentication & Email Verification Endpoints (Resend SMTP) ---

let mut PENDING_REGISTRATIONS = {}
let mut PASSWORD_RESETS = {}

fn build_email_template(title, subtitle, description, otp_code):
    let p1 = "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><title>" + title + "</title><style>body{margin:0;padding:0;background:#080808;font-family:Arial,Helvetica,sans-serif;}table{border-spacing:0;border-collapse:collapse;}img{display:block;border:0;max-width:100%;}.wrapper{width:100%;background:#080808;}.container{width:100%;max-width:520px;background:#101010;}.content{padding:32px 34px;}.heading{color:#ffffff;font-size:30px;line-height:1.2;font-weight:800;margin:0;}.description{color:#b8b8b8;font-size:15px;line-height:1.8;}.otp{font-size:36px;font-weight:800;letter-spacing:8px;color:#ffffff;text-align:center;}@media screen and (max-width:600px){.container{width:100%!important;}.content{padding:26px 22px!important;}.heading{font-size:26px!important;}.otp{font-size:30px!important;letter-spacing:5px!important;}}</style></head><body style=\"margin:0;padding:0;background:#080808;\"><table role=\"presentation\" class=\"wrapper\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:20px 10px;\"><table role=\"presentation\" class=\"container\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px;background:#101010;\"><tr><td align=\"center\" style=\"padding:30px 24px;background:#080808;\"><img src=\"https://raw.githubusercontent.com/moviesflixlol/viper-music-app/main/assets/images/file_00000000c17081f4bd128998c9675258.png\" alt=\"MUSIC\" width=\"190\" style=\"width:190px;max-width:75%;height:auto;\"></td></tr><tr><td style=\"background:#000000;\"><img src=\"https://raw.githubusercontent.com/moviesflixlol/viper-music-app/main/assets/images/file_0000000006d481f495600a628de89cd7.png\" alt=\"Discover music you love\" width=\"520\" style=\"width:100%;height:auto;display:block;\"></td></tr><tr><td height=\"3\" style=\"background:#e50914;\"></td></tr><tr><td class=\"content\" style=\"padding:32px 34px;\"><p style=\"color:#e50914;font-size:12px;font-weight:700;letter-spacing:2px;margin:0 0 14px;\">" + subtitle + "</p><h1 class=\"heading\" style=\"color:#ffffff;font-size:30px;line-height:1.2;font-weight:800;margin:0 0 18px;\">" + title + "</h1><p class=\"description\" style=\"color:#b8b8b8;font-size:15px;line-height:1.8;margin:0 0 20px;\">" + description + "</p><p style=\"color:#ffffff;font-size:16px;font-weight:700;margin:26px 0 8px;\">Verify your email</p><p class=\"description\" style=\"color:#b8b8b8;font-size:14px;line-height:1.7;margin:0 0 24px;\">Use the verification code below to confirm your request. This code expires in 10 minutes.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:20px 0 28px;\"><tr><td align=\"center\" style=\"background:#181818;border:1px solid #282828;border-radius:8px;padding:24px 20px;\"><span style=\"display:block;font-size:11px;font-weight:700;letter-spacing:2px;color:#737373;text-transform:uppercase;margin-bottom:8px;\">Verification Code</span><span class=\"otp\" style=\"font-family:\x27Courier New\x27,Courier,monospace;font-size:36px;font-weight:800;letter-spacing:8px;color:#ffffff;display:block;\">" + otp_code + "</span></td></tr></table><p style=\"color:#737373;font-size:13px;line-height:1.6;margin:0 0 20px;\">If you didn\x27t request this code, you can safely ignore this email.</p><hr style=\"border:0;border-top:1px solid #222222;margin:24px 0;\"><p style=\"color:#505050;font-size:12px;line-height:1.6;margin:0;\">Need help? Contact our support team.</p></td></tr><tr><td style=\"padding:24px 34px 30px;background:#0a0a0a;border-top:1px solid #181818;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"color:#505050;font-size:11px;line-height:1.6;\">&copy; 2026 MUSIC. All rights reserved.</td></tr></table></td></tr></table></td></tr></table></body></html>"
    return p1

fn send_resend_email(to_email, subject, html_content):
    let api_key = env.get("RESEND_API_KEY")
    if api_key == nil or len(str(api_key)) == 0:
        print("[Resend Warning] RESEND_API_KEY is not set. Email delivery skipped.")
        return false

    let payload = {
        "from": "MUSIC <noreply@movieflix.lol>",
        "to": [to_email],
        "subject": subject,
        "html": html_content
    }

    let res = http.request({
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": {
            "Authorization": "Bearer " + str(api_key),
            "Content-Type": "application/json"
        },
        "body": json.stringify(payload)
    })

    print("[Resend API] Sent to:", to_email, "Status:", res.status)
    if res.status >= 200 and res.status < 300:
        return true
    else:
        print("[Resend API Error]:", res.text)
        return false

// Register New User (Stage 1: Sends OTP to Email)
fn handle_register(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing required fields: email and password" }
        }

    let email = body["email"]
    let password = body["password"]
    let mut name = "Viper User"
    if contains(keys(body), "name") and len(body["name"]) > 0:
        name = body["name"]

    let mut interests = []
    if contains(keys(body), "interests"):
        interests = body["interests"]

    if len(email) < 4 or len(password) < 6:
        return {
            "status": 400,
            "body": { "error": "Email must be valid and password must be at least 6 characters" }
        }

    // Check if user already exists
    for u in users:
        if u["email"] == email:
            return {
                "status": 409,
                "body": { "error": "An account with this email already exists" }
            }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)
    let password_hash = crypto.hash_password(password)

    PENDING_REGISTRATIONS[email] = {
        "email": email,
        "name": name,
        "passwordHash": password_hash,
        "interests": interests,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    let html = build_email_template("Your music journey starts here.", "WELCOME TO MUSIC", "Welcome to MUSIC! Discover your favorite artists, explore new sounds, and enjoy playlists made just for you.", otp_code)
    send_resend_email(email, "Welcome to MUSIC - Verify Your Email", html)

    print("Issued verification code for new user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "verificationRequired": true,
            "email": email,
            "message": "Verification code sent to " + email
        }
    }

app.post("/api/auth/register", handle_register)

// Verify Email with 6-digit OTP (Stage 2: Completes Signup)
fn handle_verify_email(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code"):
        return {
            "status": 400,
            "body": { "error": "Missing email or verification code" }
        }

    let email = body["email"]
    let code = body["code"]

    if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No pending registration found for this email. Please sign up again." }
        }

    let pending = PENDING_REGISTRATIONS[email]
    if time.now() > pending["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Verification code has expired. Please request a new code." }
        }

    if pending["otp"] != code:
        return {
            "status": 400,
            "body": { "error": "Invalid verification code. Please check your email and try again." }
        }

    // Register user permanently
    let user_id = "usr_" + str(time.now()) + "_" + crypto.random_bytes(4)
    let new_user = {
        "id": user_id,
        "email": pending["email"],
        "name": pending["name"],
        "passwordHash": pending["passwordHash"],
        "createdAt": time.now(),
        "emailVerified": true
    }
    append(users, new_user)
    save_db("users.json", users)

    // Initialize user profile with selected interests
    let mut user_genres = {}
    for g in pending["interests"]:
        user_genres[g] = 1.0

    profiles[user_id] = {
        "userId": user_id,
        "preferredArtists": {},
        "preferredGenres": user_genres,
        "likedTracks": [],
        "dislikedTracks": [],
        "history": [],
        "skippedTracks": []
    }
    save_db("profiles.json", profiles)

    PENDING_REGISTRATIONS[email] = nil

    // Issue JWT Token
    let token_payload = {
        "userId": user_id,
        "email": email,
        "name": pending["name"],
        "exp": time.now() + 2592000 // 30 days
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("Verified email and registered user:", email, "(" + user_id + ")")

    return {
        "status": 201,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": user_id,
                "email": email,
                "name": pending["name"]
            }
        }
    }

app.post("/api/auth/verify-email", handle_verify_email)

// Request Password Reset OTP
fn handle_forgot_password(req):
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email address" }
        }

    let email = body["email"]
    let mut found = false
    for u in users:
        if u["email"] == email:
            found = true

    if !found:
        return {
            "status": 404,
            "body": { "error": "No account registered with this email address." }
        }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    PASSWORD_RESETS[email] = {
        "email": email,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    let html = build_email_template("Reset your password.", "ACCOUNT SECURITY", "Use the verification code below to reset your password. This code expires in 10 minutes.", otp_code)
    send_resend_email(email, "Password Reset Code - MUSIC", html)

    print("Issued password reset code for:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Password reset code sent to your email."
        }
    }

app.post("/api/auth/forgot-password", handle_forgot_password)

// Complete Password Reset
fn handle_reset_password(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code") or !contains(keys(body), "newPassword"):
        return {
            "status": 400,
            "body": { "error": "Missing email, code, or newPassword" }
        }

    let email = body["email"]
    let code = body["code"]
    let newPassword = body["newPassword"]

    if len(newPassword) < 6:
        return {
            "status": 400,
            "body": { "error": "New password must be at least 6 characters" }
        }

    if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No password reset request found for this email." }
        }

    let reset_req = PASSWORD_RESETS[email]
    if time.now() > reset_req["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Password reset code has expired. Please request a new one." }
        }

    if reset_req["otp"] != code:
        return {
            "status": 400,
            "body": { "error": "Invalid reset code. Please check your email and try again." }
        }

    let new_hash = crypto.hash_password(newPassword)
    for u in users:
        if u["email"] == email:
            u["passwordHash"] = new_hash

    save_db("users.json", users)
    PASSWORD_RESETS[email] = nil

    print("Successfully reset password for user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Your password has been reset successfully. You can now log in."
        }
    }

app.post("/api/auth/reset-password", handle_reset_password)

// Resend Verification / Reset Code
fn handle_resend_code(req):
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email" }
        }

    let email = body["email"]
    let mut req_type = "signup"
    if contains(keys(body), "type"):
        req_type = body["type"]

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    if req_type == "reset":
        if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending reset request for this email." }
            }
        PASSWORD_RESETS[email]["otp"] = otp_code
        PASSWORD_RESETS[email]["expiresAt"] = time.now() + 600.0
        let html = build_email_template("Reset your password.", "ACCOUNT SECURITY", "Use the verification code below to reset your password. This code expires in 10 minutes.", otp_code)
        send_resend_email(email, "Password Reset Code - MUSIC", html)
        return {
            "status": 200,
            "body": { "success": true, "message": "A new password reset code has been sent." }
        }
    else:
        if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending registration for this email." }
            }
        PENDING_REGISTRATIONS[email]["otp"] = otp_code
        PENDING_REGISTRATIONS[email]["expiresAt"] = time.now() + 600.0
        let html = build_email_template("Your music journey starts here.", "WELCOME TO MUSIC", "Welcome to MUSIC! Discover your favorite artists, explore new sounds, and enjoy playlists made just for you.", otp_code)
        send_resend_email(email, "Welcome to MUSIC - Verify Your Email", html)
        return {
            "status": 200,
            "body": { "success": true, "message": "A new verification code has been sent." }
        }

app.post("/api/auth/resend-code", handle_resend_code)

// Login User
fn handle_login(req):
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing email or password" }
        }

    let email = body["email"]
    let password = body["password"]

    let mut found_user = nil
    for u in users:
        if u["email"] == email:
            found_user = u

    if found_user == nil:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    let valid = crypto.verify_password(password, found_user["passwordHash"])
    if !valid:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    // Issue new JWT Token
    let token_payload = {
        "userId": found_user["id"],
        "email": found_user["email"],
        "name": found_user["name"],
        "exp": time.now() + 2592000
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("User logged in successfully:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": found_user["id"],
                "email": found_user["email"],
                "name": found_user["name"]
            }
        }
    }

app.post("/api/auth/login", handle_login)

// Get Current User Profile
fn handle_me(req):
    let claims = authenticate_request(req)
    if claims == nil:
        return {
            "status": 401,
            "body": { "error": "Unauthorized. Invalid or missing token." }
        }

    let user_id = claims["userId"]
    let mut current_user = nil
    for u in users:
        if u["id"] == user_id:
            current_user = u

    if current_user == nil:
        return {
            "status": 404,
            "body": { "error": "User not found" }
        }

    return {
        "status": 200,
        "body": {
            "user": {
                "id": current_user["id"],
                "email": current_user["email"],
                "name": current_user["name"],
                "createdAt": current_user["createdAt"]
            }
        }
    }

app.get("/api/auth/me", handle_me)

