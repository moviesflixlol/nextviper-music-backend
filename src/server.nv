import recommendations
import rate_limits

print("==================================================")
print("  Initializing NextViper Modular Music Backend    ")
print("  Runtime: NextViper 1.0.0 (Apex)                 ")
print("==================================================")

let JWT_SECRET = env.get("VIPER_JWT_SECRET", "")
if len(JWT_SECRET) < 64:
    print("VIPER_JWT_SECRET must be configured with at least 64 characters")
    process.exit(1)

// Initialize In-Memory / Persistent Storage
let mut users = database.load_db("users.json", [])
let mut playlists = database.load_db("playlists.json", [])
let mut events = database.load_db("events.json", [])
let mut profiles = database.load_db("profiles.json", {})

let mut PENDING_REGISTRATIONS = {}
let mut PASSWORD_RESETS = {}

print("Loaded Database:")
print(" - Users count: " + str(len(users)))
print(" - Playlists count: " + str(len(playlists)))
print(" - Events count: " + str(len(events)))

let app = http.server()

// --- CORS & Authentication Middleware ---

fn authenticate_request(req):
    let headers = req["headers"]
    if !contains(keys(headers), "authorization"):
        return nil

    let auth_header = headers["authorization"]
    if len(auth_header) < 8 or auth_header[0:7] != "Bearer ":
        return nil

    let mut token = ""
    if len(auth_header) > 7:
        token = auth_header[7:]

    let claims = crypto.jwt_decode(token, JWT_SECRET)
    if typeof(claims) != "Object":
        return nil
    if !contains(keys(claims), "userId") or !contains(keys(claims), "exp"):
        return nil
    if typeof(claims["userId"]) != "String" or len(claims["userId"]) == 0:
        return nil
    if typeof(claims["exp"]) != "Int" and typeof(claims["exp"]) != "Float":
        return nil
    if claims["exp"] <= time.now():
        return nil
    let mut exists = false
    for user in users:
        if user["id"] == claims["userId"]:
            exists = true
    if !exists:
        return nil
    return claims

// Device IDs identify existing guest libraries; they never transfer ownership.
fn playlist_owner(req):
    let claims = authenticate_request(req)
    if claims != nil:
        return claims["userId"]
    let headers = req["headers"]
    if contains(keys(headers), "authorization"):
        return ""
    let mut device_id = ""
    if contains(keys(headers), "x-device-id"):
        device_id = headers["x-device-id"]
    elif contains(keys(headers), "x-session-id"):
        device_id = headers["x-session-id"]
    if len(device_id) > 8 and device_id[0:4] == "dev_" and device_id != "dev_guest":
        return device_id
    return ""

fn can_edit_playlist(req, playlist):
    let owner = playlist_owner(req)
    return len(owner) > 0 and playlist["userId"] == owner

// --- 1. Health Endpoint ---

fn handle_health(req):
    return {
        "status": 200,
        "body": {
            "status": "healthy",
            "service": "nextviper-music-backend",
            "language": "NextViper",
            "runtime": "NextViper 1.0.0 (Apex)",
            "version": "2.1.0-production-modular",
            "timestamp": time.now(),
            "usersCount": len(users),
            "playlistsCount": len(playlists),
            "eventsCount": len(events)
        }
    }

app.get("/health", handle_health)
app.get("/api/health", handle_health)

// --- 2. Authentication Endpoints with Resend Quota Fallback ---

// Register New User
fn handle_register(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing required fields: email and password" }
        }

    let email = body["email"]
    let email_error = rate_limits.email_throttle(email)
    if email_error != nil:
        return email_error
    let password = body["password"]
    let mut name = "Viper User"
    if contains(keys(body), "name") and len(body["name"]) > 0:
        name = body["name"]

    let mut interests = []
    if contains(keys(body), "interests"):
        interests = body["interests"]

    if len(email) < 4 or len(password) < 6:
        return {
            "status": 400,
            "body": { "error": "Email must be valid and password must be at least 6 characters" }
        }

    // Check if user already exists
    for u in users:
        if u["email"] == email:
            return {
                "status": 409,
                "body": { "error": "An account with this email already exists" }
            }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)
    let password_hash = crypto.hash_password(password)

    let email_sent = email_service.send_app_auth_email(body, email, "signup", otp_code)

    if !email_sent:
        return {"status": 503, "body": {"error": "Email delivery is unavailable. Please try again later."}}

    PENDING_REGISTRATIONS[email] = {
        "email": email,
        "name": name,
        "passwordHash": password_hash,
        "interests": interests,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    print("Issued verification code for new user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "verificationRequired": true,
            "email": email,
            "message": "Verification code sent to " + email
        }
    }

app.post("/api/auth/register", handle_register)

// Verify Email with 6-digit OTP
fn handle_verify_email(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code"):
        return {
            "status": 400,
            "body": { "error": "Missing email or verification code" }
        }

    let email = body["email"]
    let code = string.trim(str(body["code"]))

    if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No pending registration found for this email. Please sign up again." }
        }

    let pending = PENDING_REGISTRATIONS[email]
    if time.now() > pending["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Verification code has expired. Please request a new code." }
        }

    if pending["otp"] != code:
        let mut attempts = 0
        if contains(keys(pending), "attempts"):
            attempts = pending["attempts"]
        pending["attempts"] = attempts + 1
        if attempts + 1 >= 5:
            PENDING_REGISTRATIONS[email] = nil
            return {"status": 429, "headers": {"Retry-After": "600"}, "body": {"error": "Too many incorrect codes. Request a new code."}}
        return {
            "status": 400,
            "body": { "error": "Invalid verification code. Please check your email and try again." }
        }

    let user_id = "usr_" + str(time.now()) + "_" + crypto.random_bytes(4)
    let new_user = {
        "id": user_id,
        "email": pending["email"],
        "name": pending["name"],
        "passwordHash": pending["passwordHash"],
        "createdAt": time.now(),
        "emailVerified": true
    }
    append(users, new_user)
    database.save_db("users.json", users)

    let mut user_genres = {}
    for g in pending["interests"]:
        user_genres[g] = 1.0

    profiles[user_id] = {
        "userId": user_id,
        "preferredArtists": {},
        "preferredGenres": user_genres,
        "likedTracks": [],
        "dislikedTracks": [],
        "history": [],
        "skippedTracks": []
    }
    database.save_db("profiles.json", profiles)

    PENDING_REGISTRATIONS[email] = nil

    let token_payload = {
        "userId": user_id,
        "email": email,
        "name": pending["name"],
        "exp": int(time.now()) + 2592000
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("Verified email and registered user:", email, "(" + user_id + ")")

    return {
        "status": 201,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": user_id,
                "email": email,
                "name": pending["name"]
            }
        }
    }

app.post("/api/auth/verify-email", handle_verify_email)

// Login User
fn handle_login(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "password"):
        return {
            "status": 400,
            "body": { "error": "Missing email or password" }
        }

    let email = body["email"]
    let password = body["password"]

    let mut found_user = nil
    for u in users:
        if u["email"] == email:
            found_user = u

    if found_user == nil:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    let valid = crypto.verify_password(password, found_user["passwordHash"])
    if !valid:
        return {
            "status": 401,
            "body": { "error": "Invalid email or password" }
        }

    let token_payload = {
        "userId": found_user["id"],
        "email": found_user["email"],
        "name": found_user["name"],
        "exp": int(time.now()) + 2592000
    }
    let token = crypto.jwt_encode(token_payload, JWT_SECRET)

    print("User logged in successfully:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "token": token,
            "user": {
                "id": found_user["id"],
                "email": found_user["email"],
                "name": found_user["name"]
            }
        }
    }

app.post("/api/auth/login", handle_login)

// Request Password Reset OTP
fn handle_forgot_password(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email address" }
        }

    let email = body["email"]
    let email_error = rate_limits.email_throttle(email)
    if email_error != nil:
        return email_error
    let mut found = false
    for u in users:
        if u["email"] == email:
            found = true

    if !found:
        return {
            "status": 404,
            "body": { "error": "No account registered with this email address." }
        }

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    let email_sent = email_service.send_app_auth_email(body, email, "reset", otp_code)

    // If Resend failed (e.g. quota limit reached): return try later error!
    if !email_sent:
        return {
            "status": 429,
            "body": { "error": "Email service daily limit reached. Please try again later or contact support." }
        }

    PASSWORD_RESETS[email] = {
        "email": email,
        "otp": otp_code,
        "expiresAt": time.now() + 600.0
    }

    print("Issued password reset code for:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Password reset code sent to your email."
        }
    }

app.post("/api/auth/forgot-password", handle_forgot_password)

// Complete Password Reset
fn handle_reset_password(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email") or !contains(keys(body), "code") or !contains(keys(body), "newPassword"):
        return {
            "status": 400,
            "body": { "error": "Missing email, code, or newPassword" }
        }

    let email = body["email"]
    let code = string.trim(str(body["code"]))
    let newPassword = body["newPassword"]

    if len(newPassword) < 6:
        return {
            "status": 400,
            "body": { "error": "New password must be at least 6 characters" }
        }

    if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
        return {
            "status": 400,
            "body": { "error": "No password reset request found for this email." }
        }

    let reset_req = PASSWORD_RESETS[email]
    if time.now() > reset_req["expiresAt"]:
        return {
            "status": 400,
            "body": { "error": "Password reset code has expired. Please request a new one." }
        }

    if reset_req["otp"] != code:
        let mut attempts = 0
        if contains(keys(reset_req), "attempts"):
            attempts = reset_req["attempts"]
        reset_req["attempts"] = attempts + 1
        if attempts + 1 >= 5:
            PASSWORD_RESETS[email] = nil
            return {"status": 429, "headers": {"Retry-After": "600"}, "body": {"error": "Too many incorrect codes. Request a new code."}}
        return {
            "status": 400,
            "body": { "error": "Invalid reset code. Please check your email and try again." }
        }

    let new_hash = crypto.hash_password(newPassword)
    for u in users:
        if u["email"] == email:
            u["passwordHash"] = new_hash

    database.save_db("users.json", users)
    PASSWORD_RESETS[email] = nil

    print("Successfully reset password for user:", email)

    return {
        "status": 200,
        "body": {
            "success": true,
            "message": "Your password has been reset successfully. You can now log in."
        }
    }

app.post("/api/auth/reset-password", handle_reset_password)

// Resend Verification / Reset Code
fn handle_resend_code(req):
    let rate_error = rate_limits.check(req, "auth")
    if rate_error != nil:
        return rate_error
    let body = req.json()
    if !contains(keys(body), "email"):
        return {
            "status": 400,
            "body": { "error": "Missing email" }
        }

    let email = body["email"]
    let email_error = rate_limits.email_throttle(email)
    if email_error != nil:
        return email_error
    let mut req_type = "signup"
    if contains(keys(body), "type"):
        req_type = body["type"]

    let otp_num = 100000 + (int(time.now() * 1000.0) % 900000)
    let otp_code = str(otp_num)

    if req_type == "reset":
        if !contains(keys(PASSWORD_RESETS), email) or PASSWORD_RESETS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending reset request for this email." }
            }
        let ok = email_service.send_app_auth_email(body, email, "reset", otp_code)
        if !ok:
            return {
                "status": 429,
                "body": { "error": "Email service daily limit reached. Please try again later." }
            }
        PASSWORD_RESETS[email]["otp"] = otp_code
        PASSWORD_RESETS[email]["attempts"] = 0
        PASSWORD_RESETS[email]["expiresAt"] = time.now() + 600.0
        return {
            "status": 200,
            "body": { "success": true, "message": "A new password reset code has been sent." }
        }
    else:
        if !contains(keys(PENDING_REGISTRATIONS), email) or PENDING_REGISTRATIONS[email] == nil:
            return {
                "status": 400,
                "body": { "error": "No pending registration for this email." }
            }
        let ok = email_service.send_app_auth_email(body, email, "signup", otp_code)
        if !ok:
            return {"status": 503, "body": {"error": "Email delivery is unavailable. Please try again later."}}

        PENDING_REGISTRATIONS[email]["otp"] = otp_code
        PENDING_REGISTRATIONS[email]["attempts"] = 0
        PENDING_REGISTRATIONS[email]["expiresAt"] = time.now() + 600.0
        return {
            "status": 200,
            "body": { "success": true, "message": "A new verification code has been sent." }
        }

app.post("/api/auth/resend-code", handle_resend_code)

// Current User Profile
fn handle_me(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let claims = authenticate_request(req)
    if claims == nil:
        return {
            "status": 401,
            "body": { "error": "Unauthorized. Invalid or missing token." }
        }

    let user_id = claims["userId"]
    let mut current_user = nil
    for u in users:
        if u["id"] == user_id:
            current_user = u

    if current_user == nil:
        return {
            "status": 404,
            "body": { "error": "User not found" }
        }

    let mut email_verified = false
    if contains(keys(current_user), "emailVerified"):
        email_verified = current_user["emailVerified"] == true

    return {
        "status": 200,
        "body": {
            "user": {
                "id": current_user["id"],
                "email": current_user["email"],
                "name": current_user["name"],
                "createdAt": current_user["createdAt"],
                "emailVerified": email_verified
            }
        }
    }

app.get("/api/auth/me", handle_me)

// --- 3. Cloud Playlists Endpoints (Preserve Existing Ownership) ---

// List Playlists
fn handle_list_playlists(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let claims = authenticate_request(req)
    let headers = req["headers"]
    if contains(keys(headers), "authorization") and claims == nil:
        return { "status": 401, "body": { "error": "Sign in again." } }
    let user_id = playlist_owner(req)
    let mut user_playlists = []
    for pl in playlists:
        let pl_uid = pl["userId"]
        if pl_uid == "public" or (len(user_id) > 0 and pl_uid == user_id) or (claims == nil and pl_uid == "guest_user"):
            append(user_playlists, pl)

    return {
        "status": 200,
        "body": {
            "count": len(user_playlists),
            "playlists": user_playlists
        }
    }

app.get("/api/playlists", handle_list_playlists)

// Create New Playlist (Accepts ID from client to prevent disassociation)
fn handle_create_playlist(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let user_id = playlist_owner(req)
    if len(user_id) == 0:
        return { "status": 401, "body": { "error": "A user session or private device library is required." } }

    let body = req.json()
    if !contains(keys(body), "name") or len(body["name"]) == 0:
        return {
            "status": 400,
            "body": { "error": "Playlist name cannot be empty" }
        }

    let mut desc = "Curated by user"
    if contains(keys(body), "description"):
        desc = body["description"]

    let mut cover = "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=600&q=80"
    if contains(keys(body), "coverUrl") and len(body["coverUrl"]) > 0:
        cover = body["coverUrl"]

    let mut pl_id = "pl_" + str(time.now()) + "_" + crypto.random_bytes(4)
    if contains(keys(body), "id") and len(body["id"]) > 0:
        pl_id = body["id"]

    // Check if playlist with this ID already exists
    let mut existing_pl = nil
    for pl in playlists:
        if pl["id"] == pl_id:
            existing_pl = pl

    if existing_pl != nil:
        if !can_edit_playlist(req, existing_pl):
            return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }
        return {
            "status": 200,
            "body": existing_pl
        }

    let new_pl = {
        "id": pl_id,
        "userId": user_id,
        "name": body["name"],
        "description": desc,
        "coverUrl": cover,
        "tracks": [],
        "isAutoGenerated": false,
        "createdAt": time.now(),
        "updatedAt": time.now()
    }

    append(playlists, new_pl)
    database.save_db("playlists.json", playlists)

    print("Created cloud playlist:", body["name"], "(" + pl_id + ")")

    return {
        "status": 201,
        "body": new_pl
    }

app.post("/api/playlists", handle_create_playlist)

// Add Track to Playlist
fn handle_add_track_to_playlist(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let pl_id = req["params"]["id"]
    let body = req.json()

    if !contains(keys(body), "track"):
        return {
            "status": 400,
            "body": { "error": "Missing 'track' object in request body" }
        }

    let track = body["track"]
    let mut found_pl = nil
    for pl in playlists:
        if pl["id"] == pl_id:
            found_pl = pl

    if found_pl == nil:
        return {
            "status": 404,
            "body": { "error": "Playlist not found", "id": pl_id }
        }

    if !can_edit_playlist(req, found_pl):
        return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }

    // Avoid duplicates
    let mut already_in = false
    for t in found_pl["tracks"]:
        if t["id"] == track["id"]:
            already_in = true

    if !already_in:
        append(found_pl["tracks"], track)
        found_pl["updatedAt"] = time.now()
        database.save_db("playlists.json", playlists)

    print("Added track to playlist:", track["title"], "->", found_pl["name"])

    return {
        "status": 200,
        "body": found_pl
    }

app.post("/api/playlists/:id/tracks", handle_add_track_to_playlist)

// Delete Playlist
fn handle_delete_playlist(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let pl_id = req["params"]["id"]
    let mut new_playlists = []
    let mut deleted = false

    for pl in playlists:
        if pl["id"] == pl_id:
            if !can_edit_playlist(req, pl):
                return { "status": 403, "body": { "error": "Playlist belongs to another owner." } }
            deleted = true
        else:
            append(new_playlists, pl)

    if !deleted:
        return {
            "status": 404,
            "body": { "error": "Playlist not found", "id": pl_id }
        }

    playlists = new_playlists
    database.save_db("playlists.json", playlists)

    print("Deleted playlist:", pl_id)

    return {
        "status": 200,
        "body": { "success": true, "deleted": pl_id }
    }

app.delete("/api/playlists/:id", handle_delete_playlist)

// --- 4. Recommendation Telemetry & Category-Aware Feed ---

// Telemetry Event
fn handle_recommendation_event(req):
    let rate_error = rate_limits.check(req, "api")
    if rate_error != nil:
        return rate_error
    let claims = authenticate_request(req)
    let headers = req["headers"]
    let mut user_id = "anonymous"
    if claims != nil and contains(keys(claims), "userId"):
        user_id = claims["userId"]
    elif contains(keys(headers), "x-session-id") and len(headers["x-session-id"]) > 0:
        user_id = "device_" + crypto.hmac_sha256(JWT_SECRET, headers["x-session-id"])
    elif contains(keys(headers), "x-device-id") and len(headers["x-device-id"]) > 0:
        user_id = "device_" + crypto.hmac_sha256(JWT_SECRET, headers["x-device-id"])

    let body = req.json()
    if !contains(keys(body), "trackId") or !contains(keys(body), "eventType"):
        return {
            "status": 400,
            "body": { "error": "Missing 'trackId' or 'eventType'" }
        }

    if typeof(body["trackId"]) != "String" or len(body["trackId"]) != 11:
        return {"status": 400, "body": {"error": "Invalid track id"}}
    if !contains(["play", "complete", "listen", "like", "dislike", "skip", "add_to_playlist"], body["eventType"]):
        return {"status": 400, "body": {"error": "Invalid event type"}}
    if body["eventType"] == "listen":
        if !contains(keys(body), "playedSeconds") or typeof(body["playedSeconds"]) != "Int":
            return {"status": 400, "body": {"error": "Missing listened duration"}}
        if !contains(keys(body), "title") or typeof(body["title"]) != "String" or len(body["title"]) > 500:
            return {"status": 400, "body": {"error": "Missing track title"}}
        if !contains(keys(body), "thumbnail") or typeof(body["thumbnail"]) != "String" or len(body["thumbnail"]) > 2000:
            return {"status": 400, "body": {"error": "Missing artwork"}}
    recommendations.record_event(profiles, events, user_id, body)
    database.save_db("events.json", events)
    database.save_db("profiles.json", profiles)

    print("Telemetry recorded:", body["eventType"], "for", body["trackId"], "(user: " + user_id + ")")

    return {
        "status": 200,
        "body": { "success": true, "message": "Signal recorded" }
    }

app.post("/api/recommendations/event", handle_recommendation_event)

// Recommendations Feed (Category-Aware: All / Music / Podcasts)
fn handle_feed(req):
    let rate_error = rate_limits.check(req, "feed")
    if rate_error != nil:
        return rate_error
    let claims = authenticate_request(req)
    let headers = req["headers"]
    let mut user_id = ""
    if claims != nil and contains(keys(claims), "userId"):
        user_id = claims["userId"]
    elif contains(keys(headers), "x-session-id") and len(headers["x-session-id"]) > 0:
        user_id = "device_" + crypto.hmac_sha256(JWT_SECRET, headers["x-session-id"])
    elif contains(keys(headers), "x-device-id") and len(headers["x-device-id"]) > 0:
        user_id = "device_" + crypto.hmac_sha256(JWT_SECRET, headers["x-device-id"])

    let mut user_prof = nil
    if len(user_id) > 0 and contains(keys(profiles), user_id):
        user_prof = profiles[user_id]

    let query_map = req["query"]
    let mut category = "All"
    if contains(keys(query_map), "category"):
        category = query_map["category"]

    let mut country = "IN"
    if contains(keys(query_map), "country") and len(query_map["country"]) > 0:
        country = query_map["country"]
    elif contains(keys(headers), "cf-ipcountry") and len(headers["cf-ipcountry"]) > 0:
        country = headers["cf-ipcountry"]
    elif contains(keys(headers), "x-country-code") and len(headers["x-country-code"]) > 0:
        country = headers["x-country-code"]

    if contains(keys(query_map), "cursor") and len(query_map["cursor"]) > 0:
        if len(query_map["cursor"]) > 8192:
            return {"status": 400, "body": {"error": "Invalid page cursor"}}
        let page = innertube.request_items("next", {"continuation": query_map["cursor"]}, country)
        if contains(keys(page), "upstreamError"):
            return {"status": 502, "body": {"error": "Music provider unavailable. Try again."}}
        let mut excluded_page = []
        if contains(keys(query_map), "exclude") and len(query_map["exclude"]) < 6000:
            excluded_page = string.split(query_map["exclude"], ",")
        let mut disliked_page = []
        let mut skipped_page = []
        if user_prof != nil:
            disliked_page = user_prof["dislikedTracks"]
            skipped_page = user_prof["skippedTracks"]
        let tracks = recommendations.choose_tracks([page["songs"]], excluded_page, disliked_page, skipped_page, [], 50)
        return {"status": 200, "body": {"country": country, "recommendedForYou": tracks, "nextCursor": page["nextCursor"], "hasMore": len(page["nextCursor"]) > 0}}

    let releases = innertube.browse("FEmusic_new_releases", country)
    let charts = innertube.charts(country)
    let most = recommendations.most_listened(user_prof)
    let mut next_cursor = charts["nextCursor"]
    let mut pools = []
    let mut history = []
    let mut disliked = []
    let mut skipped = []
    if user_prof != nil:
        history = user_prof["history"]
        disliked = user_prof["dislikedTracks"]
        skipped = user_prof["skippedTracks"]
        if len(history) > 0:
            let radio = innertube.related_page(history[len(history) - 1], country)
            append(pools, radio["songs"])
            if len(radio["nextCursor"]) > 0:
                next_cursor = radio["nextCursor"]
    if len(most) > 0:
        append(pools, innertube.related(most[0]["id"], country))
    append(pools, charts["songs"])
    if len(pools) == 1 and len(charts["songs"]) == 0:
        let mut discovery = []
        for item in releases["songs"]:
            if len(discovery) < 6:
                append(discovery, item)
        append(pools, discovery)
    let mut excluded = []
    if contains(keys(query_map), "exclude") and len(query_map["exclude"]) < 6000:
        excluded = string.split(query_map["exclude"], ",")
    let recommended = recommendations.choose_tracks(pools, excluded, disliked, skipped, history, 30)
    let mut visible_ids = []
    for item in recommended:
        append(visible_ids, item["id"])
    let trending = recommendations.choose_tracks([charts["songs"]], visible_ids, disliked, skipped, [], 12)
    for item in trending:
        append(visible_ids, item["id"])
    let new_releases = recommendations.choose_tracks([releases["songs"]], visible_ids, disliked, [], [], 18)
    let mut featured = nil
    if len(recommended) > 0:
        featured = recommended[0]
    return {"status": 200, "body": {
        "category": category, "country": country,
        "featured": featured, "recommendedForYou": recommended,
        "trending": trending, "newReleases": new_releases,
        "releaseAlbums": releases["albums"], "mostListened": most,
        "artists": charts["artists"], "mixes": [], "userInterests": [],
        "recommendationSource": "YouTube Music radio from your listening history, charts and new releases",
        "algorithmVersion": "NextViper-Radio-4.1", "nextCursor": next_cursor, "hasMore": len(next_cursor) > 0
    }}

app.get("/api/recommendations/feed", handle_feed)

// --- 5. InnerTube Search & Stream Resolver Endpoints ---

// Search Endpoint
fn handle_search(req):
    let rate_error = rate_limits.check(req, "search")
    if rate_error != nil:
        return rate_error
    let query_map = req["query"]
    let mut q = ""
    if contains(keys(query_map), "q"):
        q = query_map["q"]
    let mut country = "IN"
    if contains(keys(query_map), "country"):
        country = query_map["country"]

    if len(q) > 200:
        return {"status": 400, "body": {"error": "Search query is too long"}}
    if len(q) == 0:
        return {
            "status": 400,
            "body": { "error": "Missing 'q' query parameter" }
        }

    print("Searching YouTube Music for:", q, "(country: " + country + ")")
    let search_data = innertube.search_all(q, country)
    let results = search_data["songs"]

    return {
        "status": 200,
        "body": {
            "query": q,
            "country": country,
            "count": len(results),
            "results": results,
            "artists": search_data["artists"],
            "albums": search_data["albums"]
        }
    }

app.get("/api/search", handle_search)

// Browse real artist/album identities from upstream search results.
fn handle_browse(req):
    let rate_error = rate_limits.check(req, "search")
    if rate_error != nil:
        return rate_error
    let id = innertube.at(req, ["query", "id"])
    if typeof(id) != "String":
        return {"status": 400, "body": {"error": "Missing browse id"}}
    if len(id) > 100 or (!id.starts_with("UC") and !id.starts_with("MPRE")):
        return {"status": 400, "body": {"error": "Invalid browse id"}}
    let data = innertube.browse(id, "IN")
    return {"status": 200, "body": data}

app.get("/api/browse", handle_browse)

fn handle_related(req):
    let rate_error = rate_limits.check(req, "search")
    if rate_error != nil:
        return rate_error
    let id = innertube.at(req, ["query", "id"])
    if typeof(id) != "String" or len(id) != 11:
        return {"status": 400, "body": {"error": "Invalid track id"}}
    return {"status": 200, "body": {"results": innertube.related(id, "IN")}}

app.get("/api/related", handle_related)

// Track Stream Resolution Endpoint
fn handle_resolve(req):
    let rate_error = rate_limits.check(req, "search")
    if rate_error != nil:
        return rate_error
    let query_map = req["query"]
    let mut video_id = ""
    if contains(keys(query_map), "id"):
        video_id = query_map["id"]

    if len(video_id) == 0:
        return {
            "status": 400,
            "body": { "error": "Missing 'id' query parameter" }
        }

    let stream_res = innertube.resolve_innertube_stream(video_id)
    return stream_res

app.get("/api/resolve", handle_resolve)

// --- 6. Start Server ---

let mut port = 8080
let host = env.get("HOST", "0.0.0.0")

let env_port = env.get("PORT")
if env_port != nil and len(str(env_port)) > 0:
    port = int(env_port)

print("NextViper Production Music Backend listening on http://" + host + ":" + str(port))
app.listen(port, host, false)
