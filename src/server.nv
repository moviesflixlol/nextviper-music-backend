let JWT_SECRET = "nextviper_production_jwt_master_secret_2026_apex_cloud"
let DATA_DIR = "./data"

if !fs.exists(DATA_DIR):
    fs.mkdir(DATA_DIR)

// --- Database Helper Functions ---

fn load_db(filename, default_val):
    let path = DATA_DIR + "/" + filename
    if !fs.exists(path):
        fs.write_text(path, json.stringify(default_val))
        return default_val
    let content = fs.read_text(path)
    if len(content) == 0:
        return default_val
    return json.parse(content)

fn save_db(filename, data):
    let path = DATA_DIR + "/" + filename
    fs.write_text(path, json.stringify(data))

// Initialize Storage Files
let mut users = load_db("users.json", [])
let mut playlists = load_db("playlists.json", [])
let mut events = load_db("events.json", [])
let mut profiles = load_db("profiles.json", {})

print("Loaded Database:")
print(" - Users count: " + str(len(users)))
print(" - Playlists count: " + str(len(playlists)))
print(" - Events count: " + str(len(events)))

