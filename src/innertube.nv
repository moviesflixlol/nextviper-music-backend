// Parse the current YouTube Music renderers, preserving real browse identities.
import std.http
import std.json
import std.time

let mut SEARCH_CACHE = {}

fn at(node, path):
    let mut value = node
    for part in path:
        if typeof(value) == "Object" and contains(keys(value), part):
            value = value[part]
        else:
            return nil
    return value

fn text_of(node):
    if typeof(node) != "Object":
        return ""
    if contains(keys(node), "simpleText"):
        return node["simpleText"]
    let runs = at(node, ["runs"])
    let mut value = ""
    if typeof(runs) == "Array":
        for run in runs:
            let t = at(run, ["text"])
            if typeof(t) == "String":
                value = value + t
    return value

fn image_of(node):
    if typeof(node) == "Object":
        let thumbs = at(node, ["thumbnails"])
        if typeof(thumbs) == "Array" and len(thumbs) > 0:
            return thumbs[len(thumbs) - 1]["url"]
        for key in keys(node):
            if key != "menu" and key != "overlay":
                let found = image_of(node[key])
                if len(found) > 0:
                    return found
    return ""

fn endpoint_of(node):
    let ep = at(node, ["navigationEndpoint"])
    if ep != nil:
        return ep
    let runs = at(node, ["runs"])
    if typeof(runs) == "Array":
        for run in runs:
            let candidate = at(run, ["navigationEndpoint"])
            if candidate != nil:
                return candidate
    return {}

fn parse_item(r, inherited_artist):
    let mut title_node = at(r, ["title"])
    let mut metadata = at(r, ["subtitle"])
    let flex = at(r, ["flexColumns"])
    if typeof(flex) == "Array" and len(flex) > 0:
        title_node = at(flex[0], ["musicResponsiveListItemFlexColumnRenderer", "text"])
        if len(flex) > 1:
            metadata = at(flex[1], ["musicResponsiveListItemFlexColumnRenderer", "text"])
    if at(r, ["longBylineText"]) != nil:
        metadata = r["longBylineText"]
    let title = text_of(title_node)
    let mut ep = endpoint_of(r)
    if len(keys(ep)) == 0:
        ep = endpoint_of(title_node)
    let mut video_id = at(r, ["playlistItemData", "videoId"])
    if video_id == nil:
        video_id = at(r, ["videoId"])
    if video_id == nil:
        video_id = at(ep, ["watchEndpoint", "videoId"])
    let browse_id = at(ep, ["browseEndpoint", "browseId"])
    let page_type = at(ep, ["browseEndpoint", "browseEndpointContextSupportedConfigs", "browseEndpointContextMusicConfig", "pageType"])
    let mut artist = inherited_artist
    let mut artist_id = ""
    let mut duration = text_of(at(r, ["lengthText"]))
    let runs = at(metadata, ["runs"])
    if typeof(runs) == "Array":
        for run in runs:
            let re = endpoint_of(run)
            let aid = at(re, ["browseEndpoint", "browseId"])
            let t = text_of({"runs": [run]})
            if typeof(aid) == "String" and aid.starts_with("UC") and len(artist_id) == 0:
                artist = t
                artist_id = aid
            if t.contains(":") and len(t) < 10:
                duration = t
        if len(artist) == 0 and len(runs) > 0:
            let first = runs[0]["text"]
            if first != "Song" and first != "Video" and first != "Album" and first != "Single" and first != "Artist" and !(len(first) == 4 and first.starts_with("20")):
                artist = first
    if typeof(flex) == "Array":
        for column in flex:
            let value = text_of(at(column, ["musicResponsiveListItemFlexColumnRenderer", "text"]))
            if value.contains(":") and len(value) < 10:
                duration = value
    let fixed = at(r, ["fixedColumns"])
    if typeof(fixed) == "Array" and len(fixed) > 0:
        duration = text_of(at(fixed[0], ["musicResponsiveListItemFixedColumnRenderer", "text"]))
    if typeof(runs) == "Array" and len(runs) > 0 and runs[0]["text"] == "Episode":
        return nil
    let thumbnail = image_of(r)
    if typeof(video_id) == "String" and len(video_id) > 0 and len(title) > 0:
        return {"kind": "song", "id": video_id, "title": title, "artist": artist, "artistId": artist_id, "duration": duration, "thumbnail": thumbnail, "genre": "", "source": "youtube_music"}
    if typeof(browse_id) == "String" and len(title) > 0:
        if page_type == "MUSIC_PAGE_TYPE_ARTIST":
            return {"kind": "artist", "id": browse_id, "name": title, "imageUrl": thumbnail, "genre": "", "subtitle": text_of(metadata)}
        if page_type == "MUSIC_PAGE_TYPE_ALBUM":
            return {"kind": "album", "id": browse_id, "title": title, "artist": artist, "thumbnail": thumbnail, "subtitle": text_of(metadata)}
    return nil

fn collect(node, out, inherited_artist):
    if typeof(node) == "Array":
        for value in node:
            collect(value, out, inherited_artist)
    elif typeof(node) == "Object":
        if contains(keys(node), "musicCarouselShelfRenderer"):
            let shelf = node["musicCarouselShelfRenderer"]
            let title = text_of(at(shelf, ["header", "musicCarouselShelfBasicHeaderRenderer", "title"]))
            let start = len(out)
            collect(at(shelf, ["contents"]), out, inherited_artist)
            for i in range(start, len(out)):
                out[i]["section"] = title
            return nil
        for kind in ["musicResponsiveListItemRenderer", "musicTwoRowItemRenderer", "playlistPanelVideoRenderer", "musicCardShelfRenderer"]:
            if contains(keys(node), kind):
                let r = node[kind]
                let item = parse_item(r, inherited_artist)
                let mut child_artist = inherited_artist
                if item != nil:
                    append(out, item)
                    if item["kind"] == "artist":
                        child_artist = item["name"]
                if kind == "musicCardShelfRenderer" and at(r, ["contents"]) != nil:
                    collect(r["contents"], out, child_artist)
                return nil
        for key in keys(node):
            if key != "menu" and key != "overlay" and key != "trackingParams":
                collect(node[key], out, inherited_artist)
    return nil

fn parse_response(data):
    let mut items = []
    collect(data, items, "")
    let mut result = {"songs": [], "artists": [], "albums": []}
    let mut seen = []
    for item in items:
        if !contains(seen, item["id"]):
            append(seen, item["id"])
            if item["kind"] == "song":
                append(result["songs"], item)
            elif item["kind"] == "artist":
                append(result["artists"], item)
            elif item["kind"] == "album":
                append(result["albums"], item)
    return result

fn build_innertube_headers():
    return {"Content-Type": "application/json", "User-Agent": "Mozilla/5.0", "Origin": "https://music.youtube.com", "Referer": "https://music.youtube.com/"}

fn build_ios_headers():
    return {"Content-Type": "application/json", "User-Agent": "com.google.ios.youtube/21.03.1 (iPhone16,2; U; CPU iOS 18_2 like Mac OS X;)"}

fn request_items(endpoint, extra, country):
    let cache_key = endpoint + "_" + country + "_" + json.stringify(extra)
    let now = time.now()
    if contains(keys(SEARCH_CACHE), cache_key):
        let entry = SEARCH_CACHE[cache_key]
        if now - entry["timestamp"] < 600:
            return entry["results"]
    let body = {"context": {"client": {"clientName": "WEB_REMIX", "clientVersion": "1.20241111.01.00", "hl": "en", "gl": country}}}
    for key in keys(extra):
        body[key] = extra[key]
    let res = http.exchange({"url": "https://music.youtube.com/youtubei/v1/" + endpoint, "method": "POST", "body": json.stringify(body), "headers": build_innertube_headers(), "timeout_ms": 6000})
    if !res["ok"]:
        return {"songs": [], "artists": [], "albums": []}
    let parsed = parse_response(json.parse(res["data"]["body"]))
    if len(keys(SEARCH_CACHE)) >= 128:
        SEARCH_CACHE = {}
    if len(parsed["songs"]) + len(parsed["artists"]) + len(parsed["albums"]) > 0:
        SEARCH_CACHE[cache_key] = {"timestamp": now, "results": parsed}
    return parsed

fn search_all(q, country):
    return request_items("search", {"query": q}, country)

fn execute_innertube_search(q, country):
    return search_all(q, country)["songs"]

fn search_youtube_cached(q, country):
    return execute_innertube_search(q, country)

fn search_youtube_cached_for_user(q, country, user_id):
    return execute_innertube_search(q, country)

fn browse(id, country):
    return request_items("browse", {"browseId": id}, country)

fn related(id, country):
    return request_items("next", {"videoId": id, "playlistId": "RDAMVM" + id}, country)["songs"]

fn resolve_innertube_stream(video_id):
    let body = {
        "context": {
            "client": {
                "clientName": "IOS",
                "clientVersion": "21.03.1",
                "deviceMake": "Apple",
                "deviceModel": "iPhone16,2",
                "osName": "iOS",
                "osVersion": "18.2.22C152",
                "hl": "en",
                "gl": "US"
            }
        },
        "videoId": video_id
    }

    let res = http.exchange({
        "url": "https://www.youtube.com/youtubei/v1/player",
        "method": "POST",
        "body": json.stringify(body),
        "headers": build_ios_headers(),
        "timeout_ms": 15000
    })

    if !res["ok"]:
        return {
            "status": 502,
            "body": { "error": "Failed to query YouTube player endpoint" }
        }

    let data = json.parse(res["data"]["body"])
    let mut playability = "UNKNOWN"
    if contains(keys(data), "playabilityStatus"):
        playability = data["playabilityStatus"]["status"]

    let mut audio_streams = []
    if contains(keys(data), "streamingData"):
        let sd = data["streamingData"]
        if contains(keys(sd), "adaptiveFormats"):
            let af = sd["adaptiveFormats"]
            for f in af {
                let mime = f["mimeType"]
                if mime.contains("audio"):
                    let mut stream_info = {
                        "itag": f["itag"],
                        "mimeType": mime,
                        "bitrate": f["bitrate"]
                    }
                    if contains(keys(f), "url"):
                        stream_info["url"] = f["url"]
                        stream_info["hasDirectUrl"] = true
                    else:
                        stream_info["hasDirectUrl"] = false
                    append(audio_streams, stream_info)
            }

    return {
        "status": 200,
        "body": {
            "videoId": video_id,
            "playabilityStatus": playability,
            "streamsCount": len(audio_streams),
            "audioStreams": audio_streams
        }
    }
