// NextViper Music Backend - Email & Notifications Module
// Powered by Resend API with Dark HTML Email Template and Quota Handling

import std.env
import std.http
import std.json

fn build_email_template(title, subtitle, description, otp_code):
    let p1 = "<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"><meta name=\"color-scheme\" content=\"dark\"><title>" + title + "</title><style>body{margin:0;padding:0;background:#080808;font-family:Arial,Helvetica,sans-serif;}table{border-spacing:0;border-collapse:collapse;}img{display:block;border:0;max-width:100%;}.wrapper{width:100%;background:#080808;}.container{width:100%;max-width:520px;background:#101010;}.content{padding:32px 34px;}.heading{color:#ffffff;font-size:30px;line-height:1.2;font-weight:800;margin:0;}.description{color:#b8b8b8;font-size:15px;line-height:1.8;}.otp{font-size:36px;font-weight:800;letter-spacing:8px;color:#ffffff;text-align:center;}@media screen and (max-width:600px){.container{width:100%!important;}.content{padding:26px 22px!important;}.heading{font-size:26px!important;}.otp{font-size:30px!important;letter-spacing:5px!important;}}</style></head><body style=\"margin:0;padding:0;background:#080808;\"><table role=\"presentation\" class=\"wrapper\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td align=\"center\" style=\"padding:20px 10px;\"><table role=\"presentation\" class=\"container\" width=\"520\" cellpadding=\"0\" cellspacing=\"0\" style=\"max-width:520px;background:#101010;\"><tr><td align=\"center\" style=\"padding:30px 24px;background:#080808;\"><img src=\"https://raw.githubusercontent.com/moviesflixlol/viper-music-app/main/assets/images/file_00000000c17081f4bd128998c9675258.png\" alt=\"MUSIC\" width=\"190\" style=\"width:190px;max-width:75%;height:auto;\"></td></tr><tr><td style=\"background:#000000;\"><img src=\"https://raw.githubusercontent.com/moviesflixlol/viper-music-app/main/assets/images/file_0000000006d481f495600a628de89cd7.png\" alt=\"Discover music you love\" width=\"520\" style=\"width:100%;height:auto;display:block;\"></td></tr><tr><td height=\"3\" style=\"background:#e50914;\"></td></tr><tr><td class=\"content\" style=\"padding:32px 34px;\"><p style=\"color:#e50914;font-size:12px;font-weight:700;letter-spacing:2px;margin:0 0 14px;\">" + subtitle + "</p><h1 class=\"heading\" style=\"color:#ffffff;font-size:30px;line-height:1.2;font-weight:800;margin:0 0 18px;\">" + title + "</h1><p class=\"description\" style=\"color:#b8b8b8;font-size:15px;line-height:1.8;margin:0 0 20px;\">" + description + "</p><p style=\"color:#ffffff;font-size:16px;font-weight:700;margin:26px 0 8px;\">Verification code</p><p class=\"description\" style=\"color:#b8b8b8;font-size:14px;line-height:1.7;margin:0 0 24px;\">Use the verification code below to confirm your request. This code expires in 10 minutes.</p><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" style=\"margin:20px 0 28px;\"><tr><td align=\"center\" style=\"background:#181818;border:1px solid #282828;border-radius:8px;padding:24px 20px;\"><span style=\"display:block;font-size:11px;font-weight:700;letter-spacing:2px;color:#737373;text-transform:uppercase;margin-bottom:8px;\">Verification Code</span><span class=\"otp\" style=\"font-family:\x27Courier New\x27,Courier,monospace;font-size:36px;font-weight:800;letter-spacing:8px;color:#ffffff;display:block;\">" + otp_code + "</span></td></tr></table><p style=\"color:#737373;font-size:13px;line-height:1.6;margin:0 0 20px;\">If you didn\x27t request this code, you can safely ignore this email.</p><hr style=\"border:0;border-top:1px solid #222222;margin:24px 0;\"><p style=\"color:#505050;font-size:12px;line-height:1.6;margin:0;\">Need help? Contact our support team.</p></td></tr><tr><td style=\"padding:24px 34px 30px;background:#0a0a0a;border-top:1px solid #181818;\"><table role=\"presentation\" width=\"100%\" cellpadding=\"0\" cellspacing=\"0\"><tr><td style=\"color:#505050;font-size:11px;line-height:1.6;\">&copy; 2026 MUSIC. All rights reserved.</td></tr></table></td></tr></table></td></tr></table></body></html>"
    return p1

fn send_resend_email(to_email, subject, html_content):
    let api_key = env.get("RESEND_API_KEY")
    if api_key == nil or len(str(api_key)) == 0:
        print("[Resend Warning] RESEND_API_KEY is not configured in server environment.")
        return false

    let payload = {
        "from": "MUSIC <noreply@movieflix.lol>",
        "to": [to_email],
        "subject": subject,
        "html": html_content
    }

    let res = http.request({
        "url": "https://api.resend.com/emails",
        "method": "POST",
        "headers": {
            "Authorization": "Bearer " + str(api_key),
            "Content-Type": "application/json"
        },
        "body": json.stringify(payload)
    })

    print("[Resend API] Delivery to", to_email, "Status:", res.status)

    if res.status >= 200 and res.status < 300:
        return true
    else:
        print("[Resend API Failure - Quota or Error]:", res.text)
        return false
