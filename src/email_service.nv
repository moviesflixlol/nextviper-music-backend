-color:#161616;\"><img loading=\"lazy\" decoding=\"async\" src=\"https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSIKvpvk5ZveU-_B_ZVptRjPy1NefU0Z7gfrw&s\" alt=\"\" width=\"140\" height=\"210\" style=\"display:block;width:140px;height:210px;margin:0 10px 20px 10px;border-radius:16px;border:0;background-color:#161616;\"></div>\n          </div>\n\n          <!-- dark overlay + fade to black -->\n          <div style=\"position:absolute;top:0;left:0;right:0;bottom:0;background-color:rgba(0,0,0,0.5);background-image:linear-gradient(to bottom,rgba(0,0,0,0.25) 0%,rgba(0,0,0,0.55) 55%,#000000 100%);\">&nbsp;</div>\n\n          <!-- content over posters -->\n          <div style=\"position:relative;text-align:center;font-family:Helvetica,Arial,sans-serif;\">\n            <img fetchpriority=\"high\" decoding=\"async\" src=\"https://movieflix.lol/assets/movieflix_brand_logo.png\"\n                 alt=\"MovieFlix\" width=\"210\" style=\"display:block;width:210px;max-width:65%;height:auto;border:0;margin:0 auto;padding-top:44px;\">\n            <div style=\"height:170px;line-height:170px;font-size:0;\">&nbsp;</div>\n            <h1 style=\"margin:0 20px 12px 20px;font-size:32px;line-height:38px;color:#ffffff;font-weight:800;\">\n              Unlimited Movies,<br>TV Shows &amp; More.\n            </h1>\n            <p style=\"margin:0 28px 18px 28px;font-size:15px;line-height:23px;color:#cfcfcf;\">\n              Watch anywhere. Discover blockbusters, live series, anime, and offline downloads.\n            </p>\n            <span style=\"display:inline-block;background-color:#0d0d12;border:1px solid #2e2e33;border-radius:999px;padding:8px 14px;margin:0 3px;font-size:13px;color:#ffffff;white-space:nowrap;\"><span style=\"color:#E50914;\">&#10003;</span>&nbsp; 4K Streaming</span><span style=\"display:inline-block;background-color:#0d0d12;border:1px solid #2e2e33;border-radius:999px;padding:8px 14px;margin:0 3px;font-size:13px;color:#ffffff;white-space:nowrap;\"><span style=\"color:#E50914;\">&#10003;</span>&nbsp; Multi-Audio</span>\n          </div>\n\n        </div>\n      </td>\n    </tr>\n\n    <!-- WELCOME + OTP -->\n    <tr>\n      <td align=\"center\" style=\"padding:22px 28px 0 28px;font-family:Helvetica,Arial,sans-serif;\">\n        <p style=\"margin:0;font-size:16px;line-height:25px;color:#d6d6d6;\">\n          <strong style=\"color:#ffffff;\">Welcome to MovieFlix!</strong><br>\n          Use this OTP to verify your email and enjoy watching movies, anime, web series and more.\n        </p>\n      </td>\n    </tr>\n\n    <tr>\n      <td align=\"center\" style=\"padding:26px 24px 0 24px;font-family:Helvetica,Arial,sans-serif;\">\n        <p style=\"margin:0 0 12px 0;font-size:12px;letter-spacing:2.5px;text-transform:uppercase;color:#8a8a8a;\">\n          Your verification code is\n        </p>\n        <table role=\"presentation\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\" align=\"center\" style=\"width:100%;max-width:360px;\">\n          <tr>\n            <td align=\"center\" bgcolor=\"#E50914\"\n                style=\"background-color:#E50914;border-radius:14px;padding:16px 14px;\n                       font-family:'Courier New',Courier,monospace;font-size:40px;line-height:46px;font-weight:700;letter-spacing:12px;color:#ffffff;\">\n              MF_OTP_PLACEHOLDER\n            </td>\n          </tr>\n        </table>\n        <p style=\"margin:14px 0 0 0;font-size:13px;line-height:20px;color:#9a9a9a;\">\n          Expires in <strong style=\"color:#ffffff;\">10 minutes</strong>\n        </p>\n      </td>\n    </tr>\n\n    <!-- SECURITY NOTE -->\n    <tr>\n      <td align=\"center\" style=\"padding:18px 28px 8px 28px;font-family:Helvetica,Arial,sans-serif;\">\n        <p style=\"margin:0;font-size:12px;line-height:19px;color:#7d7d7d;\">\n          Never share this code with anyone. MovieFlix will never ask for it.<br>\n          Didn&rsquo;t request this? You can safely ignore this email.\n        </p>\n      </td>\n    </tr>\n\n    <!-- FOOTER -->\n    <tr>\n      <td align=\"center\" style=\"padding:22px 28px 36px 28px;font-family:Helvetica,Arial,sans-serif;\">\n        <img loading=\"lazy\" decoding=\"async\" src=\"https://movieflix.lol/assets/movieflix_brand_logo.png\"\n             alt=\"MovieFlix\" width=\"110\" style=\"display:block;width:110px;height:auto;border:0;margin:0 auto 16px auto;\">\n        <p style=\"margin:0 0 8px 0;font-size:12px;line-height:18px;color:#7a7a7a;\">\n          &copy; MovieFlix. All rights reserved.\n        </p>\n        <a href=\"https://movieflix.lol/privacy\" style=\"font-size:12px;color:#bdbdbd;text-decoration:underline;\">Privacy Policy</a>\n      </td>\n    </tr>\n\n  </table>\n</td></tr>\n</table>\n\n</body>\n</html>"
    if purpose == "reset":
        html = string.replace(html, "Welcome to MovieFlix!", "Reset your MovieFlix password")
        html = string.replace(html, "Use this OTP to verify your email and enjoy watching movies, anime, web series and more.", "Use this code to reset the password for your shared MovieFlix and MUSIC account.")
    return string.replace(html, "MF_OTP_PLACEHOLDER", code)

fn send_app_auth_email(body, recipient, purpose, code):
    let mut brand = "music"
    if contains(keys(body), "app") and body["app"] == "movieflix":
        brand = "movieflix"
    let mut subject = "Welcome to MUSIC - Verify Your Email"
    let mut html = build_email_template("Your music journey starts here.", "WELCOME TO MUSIC", "Verify your email to start listening.", code)
    if purpose == "reset":
        subject = "Password Reset Code - MUSIC"
        html = build_email_template("Reset your password.", "ACCOUNT SECURITY", "Use this code to reset your password. It expires in 10 minutes.", code)
    if brand == "movieflix":
        subject = "Verify your MovieFlix email"
        if purpose == "reset":
            subject = "Reset your MovieFlix password"
        html = build_movieflix_email_template(code, purpose)
    return send_branded_resend_email(recipient, subject, html, brand)

fn send_resend_email(to_email, subject, html_content):
    return send_branded_resend_email(to_email, subject, html_content, "music")

